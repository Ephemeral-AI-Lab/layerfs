{
  "name": "ephemeral-ai-fs-workspace",
  "version": "0.1.0-rc.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "clean": "pnpm -r clean",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build && pnpm test:unit",
    "test:unit": "node scripts/run-test-suite.mjs tests --exclude=smoke,fault,performance",
    "test:smoke": "pnpm build && pnpm test:smoke:built",
    "test:smoke:built": "node scripts/run-test-suite.mjs tests/smoke",
    "test:fault": "pnpm build && pnpm test:fault:built",
    "test:fault:built": "node scripts/run-test-suite.mjs tests/fault",
    "test:performance": "pnpm build && pnpm test:performance:built",
    "test:performance:built": "node scripts/run-test-suite.mjs tests/performance",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "fixtures:check": "node scripts/generate-fixtures.mjs --check",
    "validate:m0": "pnpm fixtures:check && pnpm check:docs && pnpm check:architecture && pnpm build && pnpm check:exports && pnpm test:unit",
    "validate": "pnpm fixtures:check && pnpm check:docs && pnpm check:architecture && pnpm build && pnpm check:exports && pnpm test:unit && pnpm test:smoke:built && pnpm test:fault:built && pnpm test:performance:built"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
