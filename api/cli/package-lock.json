{
  "name": "@layerfs/cli",
  "version": "1.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@layerfs/cli",
      "version": "1.1.0",
      "dependencies": {
        "@layerfs/agent": "file:../agent"
      },
      "bin": {
