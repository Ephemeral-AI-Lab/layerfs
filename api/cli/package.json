{
  "name": "@layerfs/cli",
  "version": "2.0.0-rc.1",
  "description": "The LayerFS command-line interface: every call of the table as a shell command, with JSON and human-readable output.",
  "keywords": [
    "layerfs",
    "filesystem",
    "cli",
    "version-control",
    "sandbox",
    "workspace"
  ],
  "homepage": "https://layerfs.ai/",
  "bugs": {
    "url": "https://github.com/Ephemeral-AI-Lab/layerfs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ephemeral-AI-Lab/layerfs.git",
    "directory": "api/cli"
  },
  "type": "module",
  "bin": {
    "layerfs": "bin/layerfs"
  },
  "files": [
    "bin/layerfs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "libc": [
    "glibc"
  ],
  "scripts": {
    "prepack": "node -e \"require('node:fs').existsSync('bin/layerfs') || (console.error('bin/layerfs is missing: build the native binary before packing'), process.exit(1))\"",
    "test": "node --test test/*.mjs"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
