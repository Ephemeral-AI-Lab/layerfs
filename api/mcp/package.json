{
  "name": "@layerfs/mcp",
  "version": "1.1.0",
  "description": "LayerFS MCP server over the public Node SDK, using stdio transport",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "layerfs-mcp": "src/server.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/stdio.test.js",
    "test:real": "node --test test/real-store.test.js"
  },
  "dependencies": {
    "@layerfs/agent": "1.1.0",
    "@layerfs/backend": "1.1.0",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  }
}
