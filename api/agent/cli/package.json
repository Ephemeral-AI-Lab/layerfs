{
  "name": "@layerfs/cli",
  "version": "1.1.0",
  "description": "The layerfs command: every @layerfs/agent call as one shell command, with JSON results",
  "private": true,
  "type": "module",
  "bin": {
    "layerfs": "src/layerfs.js"
  },
  "exports": {
    ".": "./src/main.js",
    "./calls": "./src/calls.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@layerfs/agent": "file:../sdk"
  },
  "engines": {
    "node": ">=20"
  }
}
