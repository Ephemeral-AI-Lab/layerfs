-) -> CoreResult<Summary> {
-    let mut count = 0_u64;
-    for (_, id) in &children {
-        count = count
-            .checked_add(summary(store, *id, counters)?.entries)
-            .ok_or(CoreError::LengthOverflow)?;
-    }
-    emit(
-        store,
-        InodeTableNodeV1::Branch {
