-                    *start,
-                    *delete_len,
-                    file.take(*replacement_len),
-                )?
-            }
-        };
-        cdc_bytes_scanned = cdc_bytes_scanned
-            .checked_add(candidate.counters().rope.cdc_bytes_scanned)
