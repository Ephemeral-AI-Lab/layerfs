-    connection.prepare_cached(&crate::admission::fixed_insert_sql(
-        "objects",
-        &["object_id", "bytes"],
-    ))?;
-    for fact in [
-        FactKind::Commit,
-        FactKind::Branch,
-        FactKind::LayerHistory,
-        FactKind::Layer,
-        FactKind::StackHistory,
-        FactKind::Stack,
-        FactKind::AddResult,
-    ] {
