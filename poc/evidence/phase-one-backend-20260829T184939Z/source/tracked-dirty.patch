-struct ObjectTransfer<'source, 'borrow, 'destination, S: ObjectSource + ?Sized> {
-    source: &'source S,
-    seen: SeenIds,
-    active: BTreeSet<ObjectId>,
-    transfer: &'borrow mut crate::TransferPipeline<'destination>,
-}
