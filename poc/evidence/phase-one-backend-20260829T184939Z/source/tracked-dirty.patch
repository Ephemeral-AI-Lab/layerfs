-        match self.objects.get(&id) {
-            Some(bytes) if ObjectId::for_bytes(bytes) == id => callback(bytes),
-            Some(_) => Err(CoreError::IdentityMismatch),
-            None => self.store.with_authenticated_canonical(id, callback),
-        }
-    }
