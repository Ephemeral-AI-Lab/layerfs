-fn inode_underfull<S: ObjectRead>(
-    store: &S,
-    id: ObjectId,
-    counters: &mut InodeTableCounters,
-) -> CoreResult<bool> {
-    Ok(match load(store, id, counters)? {
-        InodeTableNodeV1::Leaf(entries) => entries.len() < 64,
-        InodeTableNodeV1::Branch { children, .. } => children.len() < 64,
-    })
-}
