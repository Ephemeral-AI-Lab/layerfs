-            extents.push(ExtentSliceV3::new(
-                ObjectId::from_bytes(&entry[..32])?,
-                u32::from_be_bytes(entry[32..36].try_into().unwrap()),
-                u32::from_be_bytes(entry[36..40].try_into().unwrap()),
-            )?);
