-impl<'a> TransferPipeline<'a> {
-    pub fn new(destination: &'a dyn StoreEndpoint) -> Result<Self> {
-        Ok(Self {
-            target: destination.begin_transfer()?,
-            pending_objects: Vec::new(),
-            pending_object_bytes: 0,
