-impl ObjectSource for CursorSource<'_> {
-    fn read_object(&self, id: ObjectId) -> Result<Vec<u8>> {
-        if let Some(bytes) = crate::admission::object_rows(self.connection, &[id])?.remove(&id) {
-            Ok(bytes)
-        } else {
-            self.fallback
-                .ok_or(StorageError::MissingBaseData)?
-                .read_object(id)
