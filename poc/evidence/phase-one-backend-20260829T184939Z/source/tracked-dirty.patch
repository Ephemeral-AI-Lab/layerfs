-    pub(crate) fn announce_objects(&mut self, ids: &[ObjectId]) -> Result<crate::MissingBitmap> {
-        self.stats.object_pages += 1;
-        self.stats.announced_ids += ids.len() as u64;
-        let (_, missing, _) = self.exchange(ids, None, true)?;
-        missing.validate_tail(ids.len())?;
-        Ok(missing)
-    }
-
-    pub(crate) fn stage_object(&mut self, object: CanonicalObject) -> Result<()> {
-        let bytes = object.bytes.len() as u64;
-        if !self.pending_objects.is_empty()
-            && (self.pending_objects.len() == OBJECT_BATCH_COUNT
-                || self.pending_object_bytes + object.bytes.len() > OBJECT_BATCH_BYTES)
-        {
-            self.exchange(&[], None, false)?;
-        }
-        self.stats.announced_bytes += bytes;
-        self.stats.missing_ids += 1;
-        self.stats.missing_bytes += bytes;
-        self.stats.sent_ids += 1;
-        self.stats.sent_bytes += bytes;
-        self.pending_object_bytes += object.bytes.len();
-        self.pending_objects.push(object);
-        self.stats.peak_buffer_bytes = self
-            .stats
-            .peak_buffer_bytes
-            .max(self.pending_object_bytes as u64);
-        Ok(())
-    }
-
-    fn exchange(
-        &mut self,
-        object_ids: &[ObjectId],
-        fact_ids: Option<(FactKind, &[Vec<u8>])>,
-        reply_turn: bool,
-    ) -> Result<(
-        crate::AdmissionStats,
-        crate::MissingBitmap,
-        crate::MissingBitmap,
-    )> {
-        let payload_frames = self.pending_objects.len() as u64 + 1;
-        let reply = self.target.exchange(
-            &self.pending_objects,
-            &self.pending_facts,
-            object_ids,
-            fact_ids,
-        )?;
-        self.pending_object_bytes = 0;
-        self.pending_objects.clear();
-        self.pending_facts.clear();
-        if reply_turn {
-            self.stats.wire_turns += 1;
-        } else {
-            self.stats.payload_batches += 1;
-            self.stats.payload_frames += payload_frames;
-        }
-        let (admission, objects, facts) = reply.into_parts();
-        self.stats.merge_admission(admission);
-        Ok((admission, objects, facts))
-    }
-
-    fn finish_with(
-        mut self,
-        intent: crate::TransferIntent,
-    ) -> Result<(TransferStats, crate::TransferOutcome)> {
-        if self.preannounced.is_some() {
-            return Err(StorageError::Integrity("unused preflight root"));
-        }
-        if !self.pending_objects.is_empty() {
-            self.stats.payload_batches += 1;
-            self.stats.payload_frames += self.pending_objects.len() as u64 + 1;
-        }
-        let (exchange, outcome) =
-            self.target
-                .finish(&self.pending_objects, &self.pending_facts, intent)?;
-        self.stats.wire_turns += 1;
-        self.stats.merge_admission(exchange.into_parts().0);
-        self.stats.validate()?;
-        Ok((self.stats, outcome))
-    }
-}
