+fn directory_root(path: &std::path::Path, seed: [u8; 32]) -> Result<layerfs_storage::BuiltRoot> {
+    use layerfs_content::filesystem;
+    use layerfs_content::CanonicalPath;
+    use layerfs_storage::ObjectBuffer;
