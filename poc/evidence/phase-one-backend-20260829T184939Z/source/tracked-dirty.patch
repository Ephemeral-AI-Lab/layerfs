-    }
-    let split = nearest_half(
-        entries
-            .iter()
-            .map(|(name, _)| 34 + name.as_bytes().len())
-            .collect(),
-    );
-    Ok(vec![
-        emit_directory_node(store, leaf(entries[..split].to_vec())?, counters)?,
