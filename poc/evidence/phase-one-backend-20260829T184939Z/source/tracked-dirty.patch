-            self.missing_objects(object_ids)?
-        };
-        let facts = match fact_ids {
-            Some((kind, ids)) if !ids.is_empty() => self.missing_facts(kind, ids)?,
-            _ => crate::MissingBitmap::empty(),
-        };
-        Ok(TransferExchange::new(admission, objects, facts))
-    }
-}
