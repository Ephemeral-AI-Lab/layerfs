-
-fn update_optional(hasher: &mut blake3::Hasher, value: Option<&[u8]>) {
-    match value {
-        Some(value) => {
-            hasher.update(&[1]);
-            hasher.update(value);
-        }
-        None => {
-            hasher.update(&[0]);
-        }
-    }
