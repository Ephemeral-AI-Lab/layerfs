-    UNION SELECT c.merge_parent_id FROM commits c JOIN ids ON c.commit_id=ids.id WHERE c.merge_parent_id IS NOT NULL
-) SELECT EXISTS(SELECT 1 FROM ids WHERE id=?2)";
