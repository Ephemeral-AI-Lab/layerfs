-pub(crate) fn transfer_closure<S: ObjectSource + ?Sized>(
-    source: &S,
-    root: CanonicalObject,
-    transfer: &mut crate::TransferPipeline<'_>,
-) -> Result<()> {
-    let root_id = root.id;
-    let mut walk = ObjectTransfer {
-        source,
-        seen: SeenIds::new(root_id)?,
-        active: BTreeSet::from([root_id]),
-        transfer,
-    };
-    walk.visit(root)
