-            return Ok(());
-        };
-        reachable.insert(root.0);
-        let state = decode_file_state(canonical)?;
-        self.collect_mapping(
-            Summary {
-                id: state.mapping_root,
-                bytes: state.logical_len,
-                extents: state.extent_count,
-                level: state.tree_level,
-            },
-            true,
-            reachable,
