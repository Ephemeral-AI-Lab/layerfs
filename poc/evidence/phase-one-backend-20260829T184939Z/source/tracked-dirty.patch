-        F: FnMut(ObjectId, &[u8]) -> CoreResult<()>,
-    {
-        let objects = self
-            .0
-            .read_objects(ids)
-            .map_err(|_| CoreError::MissingObject)?;
-        if objects.len() != ids.len() {
