-fn nearest_half(widths: Vec<usize>) -> usize {
-    let total: usize = widths.iter().sum();
-    let mut prefix = 0;
-    let mut best = 1;
-    let mut distance = usize::MAX;
-    for (index, width) in widths.iter().enumerate().take(widths.len() - 1) {
-        prefix += width;
-        let next = total.abs_diff(prefix * 2);
-        if next < distance {
-            best = index + 1;
-            distance = next;
-        }
-    }
-    best
-}
