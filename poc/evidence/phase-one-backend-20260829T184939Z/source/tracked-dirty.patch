-        loop {
-            match loaded.node {
-                DirectoryNodeV1::Leaf { entries, .. } => {
-                    let start = exclusive_after
-                        .map(|after| entries.partition_point(|entry| entry.0 <= *after))
-                        .unwrap_or(0);
