-     WHERE (c.parent_id IS NULL OR NOT EXISTS(SELECT 1 FROM commit_ids p WHERE p.id=c.parent_id))
-       AND (c.merge_parent_id IS NULL OR NOT EXISTS(SELECT 1 FROM commit_ids p WHERE p.id=c.merge_parent_id))
