-fn merge_optional_equal<T: Copy + Eq>(left: Option<T>, right: Option<T>) -> Option<T> {
-    match (left, right) {
-        (None, value) | (value, None) => value,
-        (Some(left), Some(right)) if left == right => Some(left),
-        (Some(_), Some(_)) => None,
-    }
-}
