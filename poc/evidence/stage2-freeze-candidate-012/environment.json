{
  "capability": "SYS_ADMIN",
  "cpu": "--cpus 1",
  "fuse_device": "/dev/fuse:rwm",
  "memory": "3g",
  "network": "none",
  "pids_limit": 512,
  "platform": "linux/arm64",
  "randomize_targets": 1,
  "reps": 3,
  "scenarios": [
    "copy 64 MiB",
    "create 1000 files",
    "find tree",
    "git init + commit 100 files",
    "mkdir tree (10x10x10)",
    "overwrite 64 MiB",
    "pure copy 64 MiB",
    "pure read 64 MiB",
    "read 64 MiB",
    "rm 1000 files",
    "stat 1000 files",
    "write 64 MiB"
  ],
  "schema": "layerfs-stage2-environment-v1",
  "target_order": null,
  "target_order_reason": "fs-bench uses unseeded shuf and does not emit the exact target order",
  "tmpfs": "/tmp:rw,nosuid,nodev,size=1g,mode=1777",
  "warmup": 1
}
