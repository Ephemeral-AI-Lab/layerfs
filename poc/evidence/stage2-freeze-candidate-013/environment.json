{
  "authoritative_reps": 3,
  "authoritative_warmup": 1,
  "capability": "SYS_ADMIN",
  "checks": {
    "all_launches_exact": true,
    "authoritative_tmp_config_exact": true,
    "authoritative_var_config_exact": true
  },
  "cpu": "--cpus 1",
  "cpu_max": "100000 100000",
  "fuse_device": "/dev/fuse:rwm",
  "memory": "3g",
  "network": "none",
  "pids_limit": 512,
  "platform": "linux/arm64",
  "randomize_targets": 1,
  "scenarios": [
    "copy 64 MiB",
    "create 1000 files",
    "find tree",
    "git init + commit 100 files",
    "mkdir tree (10x10x10)",
    "overwrite 64 MiB",
    "pure copy 64 MiB",
    "pure read 64 MiB",
    "read 64 MiB",
    "rm 1000 files",
    "stat 1000 files",
    "write 64 MiB"
  ],
  "schema": "layerfs-stage2-environment-v2",
  "status": "PASS",
  "tmpfs": "/tmp:rw,nosuid,nodev,size=1g,mode=1777"
}
