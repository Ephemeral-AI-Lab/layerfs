# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM rust:1.85.1-bookworm@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4 AS build

ARG TARGETARCH

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY tools ./tools
COPY benchmark/fs-bench-pro/Cargo.toml ./benchmark/fs-bench-pro/Cargo.toml
COPY benchmark/fs-bench-pro/src ./benchmark/fs-bench-pro/src
COPY benchmark/fs-bench-pro/*.rs ./benchmark/fs-bench-pro/
COPY benchmark/fs-bench-pro/families ./benchmark/fs-bench-pro/families
COPY benchmark/fs-bench-pro/workload.rs /workload/workload.rs
COPY benchmark/fs-bench-pro/families /workload/families
COPY benchmark/fs-bench-pro/*.rs /workload/

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    case "$TARGETARCH" in arm64) target=aarch64-unknown-linux-gnu ;; amd64) target=x86_64-unknown-linux-gnu ;; *) exit 1 ;; esac \
 && cargo test --locked --release --target "$target" -p layerfs-daemon --bin layerfs-daemon linux::tests::forced_group_cleanup_reaps_descendants_without_stealing_status -- --exact --nocapture
