+// Sampled routine verification: bounded observations, never an exhaustive proof.
+#[derive(Clone, Debug)]
+pub(crate) struct SamplePlan {
+    pub representative_paths: BTreeSet<String>,
+    pub selected_paths: BTreeSet<String>,
+    pub absent_paths: BTreeSet<String>,
+    pub ranges: BTreeMap<String, Vec<(u64, u64)>>,
+    pub identity: String,
+}
+
+pub(crate) fn sample_plan(before: &[Entry], after: &[Entry], seed: u8, domain: &str) -> Result<SamplePlan> {
+    seed_label(seed)?;
+    validate_entries(before)?;
+    validate_entries(after)?;
+    let expected = after.iter().map(|entry| (entry.path.as_str(), entry)).collect::<BTreeMap<_, _>>();
+    let previous = before.iter().map(|entry| (entry.path.as_str(), entry)).collect::<BTreeMap<_, _>>();
+    let rank = |path: &str| frame_seed(&["sampled-path-v1", domain, path], &[u64::from(seed)]);
+    let mut ranked = after.iter().collect::<Vec<_>>();
+    ranked.sort_by_key(|entry| (rank(&entry.path), entry.path.as_str()));
+    let mut representatives = BTreeSet::new();
+    for largest in [false, true] {
+        let selected = after.iter().filter_map(|entry| match &entry.kind {
+            EntryKind::File(content) => Some((content.len(), entry.path.as_str())),
+            _ => None,
+        });
+        let selected = if largest { selected.max() } else { selected.min() };
+        if let Some((_, path)) = selected { representatives.insert(path.to_owned()); }
+    }
+    // Include alias and symlink semantics when present, without deriving selections
+    // from product state. The remainder is seed/case/path hash ranking.
+    for kind in [0, 1, 2] {
+        if let Some(entry) = ranked.iter().find(|entry| match kind {
+            0 => matches!(entry.kind, EntryKind::Hardlink(_)),
+            1 => matches!(entry.kind, EntryKind::Symlink(_)),
+            _ => !previous.get(entry.path.as_str()).is_some_and(|old| {
+                (old.mode, old.mtime_seconds, old.mtime_nanoseconds) == (entry.mode, entry.mtime_seconds, entry.mtime_nanoseconds)
+                    && match (&old.kind, &entry.kind) {
+                        (EntryKind::File(a), EntryKind::File(b)) => content_recipe_equal(a, b),
+                        (EntryKind::Directory, EntryKind::Directory) => true,
+                        (EntryKind::Hardlink(a), EntryKind::Hardlink(b)) | (EntryKind::Symlink(a), EntryKind::Symlink(b)) => a == b,
+                        _ => false,
+                    }
+            }),
+        }) { representatives.insert(entry.path.clone()); }
+    }
+    if let Some(entry) = after.iter().filter(|entry| matches!(entry.kind, EntryKind::Directory))
+        .max_by_key(|entry| (entry.path.bytes().filter(|byte| *byte == b'/').count(), entry.path.as_str())) {
+        representatives.insert(entry.path.clone());
+    }
+    for entry in ranked {
+        if representatives.len() == 16 { break; }
+        representatives.insert(entry.path.clone());
+    }
+    let mut absent = before.iter().filter(|entry| !expected.contains_key(entry.path.as_str())).collect::<Vec<_>>();
+    absent.sort_by_key(|entry| (rank(&entry.path), entry.path.as_str()));
+    let absent_paths = absent.into_iter().take(8).map(|entry| entry.path.clone()).collect::<BTreeSet<_>>();
+    let delta = FastDelta { changed_paths: representatives.clone(), absent_paths: absent_paths.clone(), witness_paths: BTreeSet::new() };
+    let mut selected_paths = fast_selected_paths(after, &delta)?;
+    for path in &absent_paths {
+        let mut ancestors = BTreeSet::new(); add_fast_ancestors(&mut ancestors, path);
+        selected_paths.extend(ancestors.into_iter().filter(|path| expected.contains_key(path.as_str())));
+    }
+    let mut ranges = BTreeMap::new();
+    for path in &selected_paths {
+        let content = match &expected[path.as_str()].kind {
+            EntryKind::File(content) => Some(content),
+            EntryKind::Hardlink(target) => match &expected[target.as_str()].kind { EntryKind::File(content) => Some(content), _ => return Err("sampled hard-link source missing".into()) },
+            _ => None,
+        };
+        if let Some(content) = content {
+            if matches!(content, Content::Digest { .. }) { return Err("sampled bytes require an independent source recipe".into()); }
+            let len = content.len();
+            let count = len.min(4096);
+            let mut spans = BTreeSet::new();
+            if count != 0 {
+                spans.insert((0, count)); spans.insert((len - count, count));
+                for ordinal in 0..3 {
+                    let offset = frame_seed(&["sampled-range-v1", domain, path], &[u64::from(seed), ordinal]) % (len - count + 1);
+                    spans.insert((offset, count));
+                }
+            }
+            ranges.insert(path.clone(), spans.into_iter().collect::<Vec<_>>());
+        }
+    }
+    let mut hash = Sha256::new(); frame(&mut hash, b"sampled-plan-v1"); frame(&mut hash, domain.as_bytes()); hash.update(&[seed]);
+    for path in &selected_paths {
+        let entry = expected[path.as_str()]; frame(&mut hash, path.as_bytes());
+        hash.update(&entry.mode.to_le_bytes()); hash.update(&entry.mtime_seconds.to_le_bytes()); hash.update(&entry.mtime_nanoseconds.to_le_bytes());
+        match &entry.kind {
+            EntryKind::Directory => frame(&mut hash, b"directory"),
+            EntryKind::Symlink(target) => { frame(&mut hash, b"symlink"); frame(&mut hash, target.as_bytes()); },
+            EntryKind::Hardlink(target) => { frame(&mut hash, b"hardlink"); frame(&mut hash, target.as_bytes()); },
+            EntryKind::File(content) => { frame(&mut hash, b"file"); hash.update(&content.len().to_le_bytes()); },
+        }
+        if let Some(spans) = ranges.get(path) { for (offset, len) in spans { hash.update(&offset.to_le_bytes()); hash.update(&len.to_le_bytes()); } }
+    }
+    for path in &absent_paths { frame(&mut hash, b"absent"); frame(&mut hash, path.as_bytes()); }
+    Ok(SamplePlan { representative_paths: representatives, selected_paths, absent_paths, ranges, identity: hex(&hash.finish()) })
+}
+
+pub(crate) fn verify_native_sampled(root: &Path, entries: &[Entry], plan: &SamplePlan, seed: u8) -> Result<Receipt> {
+    seed_label(seed)?;
+    let expected = entries.iter().map(|entry| (entry.path.as_str(), entry)).collect::<BTreeMap<_, _>>();
+    let mut reference_counts = BTreeMap::<&str, u64>::new();
+    for entry in entries {
+        let class = match &entry.kind { EntryKind::File(_) => entry.path.as_str(), EntryKind::Hardlink(target) => target.as_str(), _ => continue };
+        *reference_counts.entry(class).or_default() += 1;
+    }
+    let mut inode_classes = BTreeMap::new(); let mut class_inodes = BTreeMap::new();
+    let mut actual = [0_u8; 4096]; let mut wanted = [0_u8; 4096];
+    let mut checked_bytes = 0_u64; let mut checked_ranges = 0_u64; let mut files = 0_usize;
+    let mut range_hash = Sha256::new(); frame(&mut range_hash, b"sampled-independent-ranges-v1");
+    for relative in &plan.selected_paths {
+        let entry = expected.get(relative.as_str()).ok_or("sampled selected path missing from independent oracle")?;
+        let path = root.join(relative); let metadata = fs::symlink_metadata(&path)?;
+        if metadata.mode() & 0o7777 != entry.mode || metadata.mtime() != entry.mtime_seconds || metadata.mtime_nsec() != i64::from(entry.mtime_nanoseconds) {
+            return Err(format!("sampled native metadata mismatch: {relative}").into());
+        }
+        let (content, class) = match &entry.kind {
+            EntryKind::Directory => { if !metadata.is_dir() {return Err(format!("sampled native directory type: {relative}").into());} continue; },
+            EntryKind::Symlink(target) => {
+                if !metadata.file_type().is_symlink() || fs::read_link(&path)? != Path::new(target) || metadata.len() != target.len() as u64 { return Err(format!("sampled native symlink mismatch: {relative}").into()); }
+                continue;
+            },
+            EntryKind::File(content) => (content, relative.as_str()),
+            EntryKind::Hardlink(target) => match &expected[target.as_str()].kind { EntryKind::File(content) => (content, target.as_str()), _ => return Err("sampled hard-link content missing".into()) },
+        };
+        if !metadata.is_file() || metadata.len() != content.len() { return Err(format!("sampled native type/length mismatch: {relative}").into()); }
+        let inode = (metadata.dev(), metadata.ino());
+        if metadata.nlink() != reference_counts[class]
+            || inode_classes.insert(inode, class).is_some_and(|previous| previous != class)
+            || class_inodes.insert(class, inode).is_some_and(|previous| previous != inode) {
+            return Err(format!("sampled native hard-link class/count mismatch: {relative}").into());
+        }
+        let spans = plan.ranges.get(relative).ok_or("sampled file has no range plan")?;
+        if spans.len() > 5 { return Err("sampled range count exceeds bound".into()); }
+        let mut file = File::open(&path)?;
+        for &(offset, len) in spans {
+            if len == 0 || len > 4096 || offset.checked_add(len).is_none_or(|end| end > content.len()) { return Err("invalid sampled range".into()); }
+            if content.read_at(offset, &mut wanted[..len as usize])? != len as usize { return Err("short independent sampled range".into()); }
+            file.seek(SeekFrom::Start(offset))?; file.read_exact(&mut actual[..len as usize])?;
+            if actual[..len as usize] != wanted[..len as usize] { return Err(format!("sampled native bytes mismatch: {relative} at {offset}").into()); }
+            frame(&mut range_hash, relative.as_bytes()); range_hash.update(&offset.to_le_bytes()); range_hash.update(&len.to_le_bytes()); range_hash.update(&wanted[..len as usize]);
+            checked_bytes += len; checked_ranges += 1;
+        }
+        files += 1;
+    }
+    for path in &plan.absent_paths {
+        if expected.contains_key(path.as_str()) { return Err("sampled absence exists in independent oracle".into()); }
+        match fs::symlink_metadata(root.join(path)) {
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => (),
+            Err(error) => return Err(error.into()),
+            Ok(_) => return Err(format!("sampled native expected absence: {path}").into()),
+        }
+    }
+    Ok(BTreeMap::from([
+        ("verification_status".into(), "sampled_iteration_verified".into()), ("fully_verified".into(), "false".into()),
+        ("sample_seed".into(), seed.to_string()), ("sample_plan_sha256".into(), plan.identity.clone()),
+        ("representative_paths".into(), plan.representative_paths.len().to_string()),
+        ("selected_metadata_paths_verified".into(), plan.selected_paths.len().to_string()),
+        ("selected_regular_paths_verified".into(), files.to_string()), ("selected_ranges_verified".into(), checked_ranges.to_string()),
+        ("selected_regular_bytes_verified".into(), checked_bytes.to_string()), ("selected_absences_verified".into(), plan.absent_paths.len().to_string()),
+        ("selected_paths_hex".into(), plan.selected_paths.iter().map(|path|hex(path.as_bytes())).collect::<Vec<_>>().join(",")),
+        ("selected_absences_hex".into(), plan.absent_paths.iter().map(|path|hex(path.as_bytes())).collect::<Vec<_>>().join(",")),
+        ("selected_ranges".into(), plan.ranges.iter().flat_map(|(path,spans)|spans.iter().map(move |(offset,len)|format!("{}:{offset}:{len}",hex(path.as_bytes())))).collect::<Vec<_>>().join(",")),
+        ("independent_selected_range_sha256".into(), hex(&range_hash.finish())),
+        ("omissions".into(), "no full namespace census; no unselected metadata/absence checks; no unsampled body bytes; no full content digest; no exhaustive alias/global-inode census".into()),
+        ("oracle_scope".into(), "independent expected metadata, selected alias closure and deterministic boundary/hash-ranked byte ranges".into()),
+    ]))
+}
