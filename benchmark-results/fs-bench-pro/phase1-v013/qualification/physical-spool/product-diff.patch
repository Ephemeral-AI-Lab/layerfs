+    assert!(!consume_verification_fault(
+        branch,
+        VerificationFault::ShortAppend,
+        0
+    ));
+    arm_verification_fault(branch, VerificationFault::ShortAppend).unwrap();
+    assert!(!consume_verification_fault(
+        other,
+        VerificationFault::ShortAppend,
+        0
+    ));
+    assert!(std::thread::spawn(move || consume_verification_fault(
+        branch,
