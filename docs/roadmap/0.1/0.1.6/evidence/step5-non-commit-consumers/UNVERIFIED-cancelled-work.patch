+    // ---- Explicit fsync / cache control on the host authority -------------------
+
+    /// The mounted client's explicit `fsync` reaches the host authority as one
+    /// bounded `Fsync` request. It must flush the private arenas and index,
+    /// publish nothing, surface a real I/O error, and never drain callbacks or
+    /// writers.
+    #[test]
+    fn host_authority_explicit_fsync_flushes_without_publishing_or_draining() {
+        use layerfs_fuse::host_wire::{self as wire, Operation, Reply};
+        use layerfs_fuse::FilesystemPort;
+        let (root, workspaces, branch, store) = fixture("host-explicit-fsync");
+        let (session, runtime, client) = host_authority_session(&root, &workspaces, branch);
+        // The same authenticated transport session the mounted client uses: a
+        // foreign session is correctly refused by the replay window.
+        let transport = runtime.server.host_session().unwrap();
+        let frame = |sequence: u64, operation: Operation<'_>| {
+            wire::encode_request(wire::Request {
+                session: transport,
+                sequence,
+                acknowledged: 0,
+                operation,
+            })
+            .unwrap()
+        };
+        let node = client.lookup(crate::ROOT, b"file").unwrap().node;
+        assert_eq!(client.write(node, 0, b"Z").unwrap(), 1);
+        assert_eq!(client.read(node, 0, 16).unwrap(), b"Zbcdef");
+        let commits_before = store.store_counts().unwrap().commits;
+        let covered_before = runtime.covered_sequence().unwrap();
+        let head_before = runtime.published_head().unwrap();
+        assert!(workspaces.diff(session.id).unwrap().dirty);
+
+        // A held callback and an open writer: a draining implementation would
+        // block here until its one-second quiesce deadline.
+        let worker = workspaces.worker(session.id).unwrap();
+        let callback = worker.enter_callback().unwrap();
+        worker.note_writer(true).unwrap();
+        let started = std::time::Instant::now();
+        let reply = runtime
+            .operations
+            .request(&frame(11, Operation::Fsync(Some(node))))
+            .unwrap();
+        let elapsed = started.elapsed();
+        match wire::decode_reply(&reply, 11).unwrap() {
+            Reply::Known(Ok(_)) => {}
+            Reply::Known(Err(error)) => panic!("explicit host fsync failed: {error:?}"),
+            Reply::Unknown => panic!("explicit host fsync returned an unknown reply"),
+        }
+        assert!(
+            elapsed < std::time::Duration::from_millis(500),
+            "explicit fsync must not drain writers or callbacks: {elapsed:?}"
+        );
+        worker.note_writer(false).unwrap();
+        drop(callback);
+
+        // Explicit fsync alone: no publication, no coverage, no byte change.
+        assert_eq!(store.store_counts().unwrap().commits, commits_before);
+        assert_eq!(runtime.covered_sequence().unwrap(), covered_before);
+        assert_eq!(runtime.published_head().unwrap(), head_before);
+        assert_eq!(client.read(node, 0, 16).unwrap(), b"Zbcdef");
+        assert!(workspaces.diff(session.id).unwrap().dirty);
+        let reply = runtime
+            .operations
+            .request(&frame(12, Operation::Fsync(Some(node))))
+            .unwrap();
+        assert!(matches!(
+            wire::decode_reply(&reply, 12).unwrap(),
+            Reply::Known(Ok(_))
+        ));
+        assert_eq!(store.store_counts().unwrap().commits, commits_before);
+
+        // A real I/O error is surfaced to the caller, and the failed flush
+        // still publishes nothing and leaves the acknowledged bytes intact.
+        let missing = layerfs_fuse::NodeId(9_999);
+        let reply = runtime
+            .operations
+            .request(&frame(13, Operation::Fsync(Some(missing))))
+            .unwrap();
+        match wire::decode_reply(&reply, 13).unwrap() {
+            Reply::Known(Err(error)) => {
+                assert_eq!(error, layerfs_fuse::PortError::NotFound, "{error:?}");
+            }
+            other => panic!(
+                "an fsync of an unknown inode must fail, got {}",
+                if matches!(other, Reply::Unknown) {
+                    "an unknown operation"
+                } else {
+                    "a successful reply"
+                }
+            ),
+        }
+        assert_eq!(store.store_counts().unwrap().commits, commits_before);
+        assert_eq!(runtime.covered_sequence().unwrap(), covered_before);
+        assert_eq!(client.read(node, 0, 16).unwrap(), b"Zbcdef");
+
+        // A whole-filesystem fsync (no inode) is the same explicit route.
+        let reply = runtime
+            .operations
+            .request(&frame(14, Operation::Fsync(None)))
+            .unwrap();
+        assert!(matches!(
+            wire::decode_reply(&reply, 14).unwrap(),
+            Reply::Known(Ok(_))
+        ));
+        assert_eq!(store.store_counts().unwrap().commits, commits_before);
+        assert!(workspaces.diff(session.id).unwrap().dirty);
+
+        // The explicit flush did not become an implicit one: the Commit that
+        // follows is what publishes, and it publishes exactly the live bytes.
+        assert!(matches!(
+            workspaces.commit_workspace_session(session.id).unwrap(),
+            WorkspaceCommitResult::Created { .. }
+        ));
+        assert_eq!(store.store_counts().unwrap().commits, commits_before + 1);
+        assert_eq!(
+            committed_file(&store, store.pin_branch(branch).unwrap().root),
+            b"Zbcdef"
+        );
+        assert!(!workspaces.diff(session.id).unwrap().dirty);
+        workspaces
+            .end_workspace_session(session.id, EndWorkspaceMode::Clean)
+            .unwrap();
+        std::fs::remove_dir_all(root).unwrap();
+        println!(
+            "HOST FSYNC PASS: explicit Fsync flushed through the host authority in {elapsed:?} with a held callback and open writer, published nothing, surfaced NotFound for an unknown inode, and the later Commit published exactly the live bytes"
+        );
+    }
