+/// Issues one of the step's own transaction texts.
+///
+/// Measurement-only (#209 Q3): when the lever is on, the text goes through the
+/// connection's prepared-statement cache instead of being parsed per call.
+fn batch_text(connection: &Connection, sql: &'static str) -> rusqlite::Result<()> {
+    if crate::sqlite::step_probe::statement_cache_enabled() {
+        connection.prepare_cached(sql)?.execute([])?;
+        Ok(())
+    } else {
+        connection.execute_batch(sql)
+    }
