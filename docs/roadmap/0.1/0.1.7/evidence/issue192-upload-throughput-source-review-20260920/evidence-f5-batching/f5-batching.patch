+/// Reads one length-prefixed record into a caller-owned buffer.
+fn read_record_into(io: &mut Socket, limit: usize, out: &mut Vec<u8>) -> Result<(), Failure> {
+    let mut h = [0; 4];
+    io.read_exact(&mut h)?;
+    let n = u32::from_be_bytes(h) as usize;
+    if n == 0 || n > limit {
+        return Err(Code::Capacity.into());
+    }
+    out.clear();
+    out.resize(n, 0);
+    io.read_exact(out)?;
+    Ok(())
