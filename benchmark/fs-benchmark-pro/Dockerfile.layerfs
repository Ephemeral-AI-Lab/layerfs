# syntax=docker/dockerfile:1.7

FROM rust:1.85.1-bookworm AS build

ARG TARGETARCH
ARG LAYERFS_SOURCE_COMMIT
ARG LAYERFS_SOURCE_TREE
ARG LAYERFS_SOURCE_DIRTY
ARG LAYERFS_SOURCE_SEAL

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY tools ./tools
COPY benchmark/fs-benchmark-pro ./benchmark/fs-benchmark-pro

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    test "${#LAYERFS_SOURCE_COMMIT}" -eq 40 \
 && test "${#LAYERFS_SOURCE_TREE}" -eq 40 \
 && test "${#LAYERFS_SOURCE_SEAL}" -eq 64 \
 && case "$LAYERFS_SOURCE_DIRTY" in true|false) ;; *) exit 1 ;; esac \
 && case "$LAYERFS_SOURCE_COMMIT$LAYERFS_SOURCE_TREE$LAYERFS_SOURCE_SEAL" in *[!0-9a-f]*) exit 1 ;; esac \
 && case "$TARGETARCH" in \
      arm64) target=aarch64-unknown-linux-gnu ;; \
      amd64) target=x86_64-unknown-linux-gnu ;; \
      *) exit 1 ;; \
    esac \
 && rustup target add "$target" \
 && cargo test --locked --target "$target" -p fs-benchmark-pro \
 && cargo build --locked --release --target "$target" -p fs-benchmark-pro \
 && cargo build --locked --release --target "$target" -p layerfs-fuse --no-default-features --features proxy \
 && cp "target/$target/release/fs-benchmark-pro" /fs-benchmark-pro \
 && cp "target/$target/release/layerfs-fuse" /layerfs-fuse

FROM docker:cli AS docker-cli

FROM rust:1.85.1-bookworm

ARG LAYERFS_SOURCE_COMMIT
ARG LAYERFS_SOURCE_TREE
ARG LAYERFS_SOURCE_DIRTY
ARG LAYERFS_SOURCE_SEAL

RUN mkdir -p /results /workspace /var/tmp/layerfs-owned /src/benchmark/fs-benchmark-pro

COPY --from=build /fs-benchmark-pro /usr/local/bin/fs-benchmark-pro
COPY --from=build /layerfs-fuse /usr/local/bin/layerfs-fuse
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY benchmark/fs-benchmark-pro/workload.py /src/benchmark/fs-benchmark-pro/workload.py

RUN chmod 0555 /usr/local/bin/fs-benchmark-pro /usr/local/bin/layerfs-fuse \
                  /src/benchmark/fs-benchmark-pro/workload.py \
 && python3 /src/benchmark/fs-benchmark-pro/workload.py self-check \
 && /usr/local/bin/fs-benchmark-pro self-check

LABEL org.opencontainers.image.source="https://github.com/Ephemeral-AI-Lab/layerfs" \
      org.opencontainers.image.revision="$LAYERFS_SOURCE_COMMIT" \
      org.opencontainers.image.source-tree="$LAYERFS_SOURCE_TREE" \
      dev.layerfs.source-dirty="$LAYERFS_SOURCE_DIRTY" \
      dev.layerfs.source-seal="$LAYERFS_SOURCE_SEAL"

ENV LAYERFS_SOURCE_COMMIT="$LAYERFS_SOURCE_COMMIT" \
    LAYERFS_SOURCE_TREE="$LAYERFS_SOURCE_TREE" \
    LAYERFS_SOURCE_DIRTY="$LAYERFS_SOURCE_DIRTY" \
    LAYERFS_SOURCE_SEAL="$LAYERFS_SOURCE_SEAL" \
    LAYERFS_FUSE_HELPER="/usr/local/bin/layerfs-fuse" \
    LAYERFS_FUSE_HOST="127.0.0.1"

ENTRYPOINT ["/usr/local/bin/fs-benchmark-pro"]
