# syntax=docker/dockerfile:1.7

FROM node:22.22.0-bookworm AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG COMPUTER_COMMIT=de87919a4fd37242e960e13b7b3ba802d1eef0a0
ARG COMPUTER_TREE=4fb409d7e1356e1098439293d77d2fdc2dbf2190
ARG COMPUTER_ARCHIVE_SHA256=c7d7d1b2e63c97006aee744cf0ece5af529d28a39752467b5da1247370a38b84
ARG COMPUTER_LOCK_SHA256=3484114c272ea8903963ff464e0a695baf3645659b50b2220f125103b10d505c

RUN apt-get -o Acquire::Retries=5 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      build-essential libfuse-dev python3 \
 && rm -rf /var/lib/apt/lists/*

# The build context is deliberately tiny: an exact `git archive --format=tar`
# of COMPUTER_COMMIT plus these three harness files. No product patch enters
# the image.
COPY computer-source.tar /tmp/computer-source.tar
RUN echo "${COMPUTER_ARCHIVE_SHA256}  /tmp/computer-source.tar" | sha256sum -c - \
 && mkdir -p /opt/cloudflare-computer \
 && tar -xf /tmp/computer-source.tar -C /opt/cloudflare-computer \
 && rm /tmp/computer-source.tar \
 && echo "${COMPUTER_LOCK_SHA256}  /opt/cloudflare-computer/package-lock.json" | sha256sum -c -

WORKDIR /opt/cloudflare-computer
RUN npm ci --ignore-scripts \
 && if [ "$(dpkg --print-architecture)" = arm64 ]; then \
      cp /usr/lib/aarch64-linux-gnu/libfuse.so.2 \
        node_modules/fuse-shared-library-linux/libfuse/lib/libfuse.so; \
    fi \
 && npm rebuild fuse-native \
 && npm run build --workspace @cloudflare/dofs \
 && npm run build --workspace @cloudflare/computer-rpc \
 && npm run build --workspace @cloudflare/computer \
 && npm run build --workspace @cloudflare/computerd

COPY computer.mjs computer.test.mjs /benchmark/
RUN node --no-warnings /benchmark/computer.test.mjs

FROM node:22.22.0-bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive
ARG COMPUTER_COMMIT=de87919a4fd37242e960e13b7b3ba802d1eef0a0
ARG COMPUTER_TREE=4fb409d7e1356e1098439293d77d2fdc2dbf2190
ARG COMPUTER_ARCHIVE_SHA256=c7d7d1b2e63c97006aee744cf0ece5af529d28a39752467b5da1247370a38b84
ARG COMPUTER_LOCK_SHA256=3484114c272ea8903963ff464e0a695baf3645659b50b2220f125103b10d505c

COPY --from=build /opt/cloudflare-computer /opt/cloudflare-computer
COPY --from=build /benchmark /benchmark

# Keep this apt pass downstream of the build stage. Docker Desktop's HTTP
# proxy truncates the large Debian indexes when two independent stages fetch
# them concurrently.
RUN apt-get -o Acquire::Retries=5 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends fuse libfuse2 \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /workspace /results /fixture

LABEL org.opencontainers.image.source="https://github.com/cloudflare/computer" \
      org.opencontainers.image.revision="${COMPUTER_COMMIT}" \
      org.opencontainers.image.source-tree="${COMPUTER_TREE}" \
      dev.layerfs.computer-build-mode="sealed-source-build" \
      dev.layerfs.upstream-archive-sha256="${COMPUTER_ARCHIVE_SHA256}" \
      dev.layerfs.upstream-package-lock-sha256="${COMPUTER_LOCK_SHA256}"

ENV NODE_ENV=production \
    CLOUDFLARE_COMPUTER_ROOT=/opt/cloudflare-computer

ENTRYPOINT ["node", "--no-warnings", "/benchmark/computer.mjs"]
