# syntax=docker/dockerfile:1.7

ARG COMPUTER_BASE_IMAGE=layerfs-fs-benchmark-pro-computer:reference-topology-diagnostic
FROM rust:1.85.1-bookworm AS workload

ARG WORKLOAD_SOURCE_SHA256
COPY benchmark/fs-bench-pro/workload.rs /workload/workload.rs
RUN echo "$WORKLOAD_SOURCE_SHA256  /workload/workload.rs" | sha256sum -c - \
 && rustc --edition=2021 -C opt-level=3 -C strip=symbols \
      --remap-path-prefix=/workload=. /workload/workload.rs -o /fs-benchmark-workload \
 && /fs-benchmark-workload self-check

FROM ${COMPUTER_BASE_IMAGE}

ARG WORKLOAD_SOURCE_SHA256
COPY --from=workload /fs-benchmark-workload /benchmark/fs-benchmark-workload
RUN chmod 0555 /benchmark/fs-benchmark-workload \
 && /benchmark/fs-benchmark-workload self-check

LABEL dev.layerfs.computer-build-mode="sealed-product-layer-host-authority" \
      dev.layerfs.workload-source-sha256="$WORKLOAD_SOURCE_SHA256"
