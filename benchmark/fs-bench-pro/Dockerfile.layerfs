# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM rust:1.85.1-bookworm@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4 AS workload-build

WORKDIR /src
COPY benchmark/fs-bench-pro/workload ./benchmark/fs-bench-pro/workload
COPY benchmark/fs-bench-pro/families ./benchmark/fs-bench-pro/families
RUN rustc --edition=2021 -C opt-level=3 -C strip=symbols \
      --remap-path-prefix=/src/benchmark/fs-bench-pro=. \
      benchmark/fs-bench-pro/workload/main.rs -o /fs-benchmark-workload

FROM workload-build AS build

ARG TARGETARCH
ARG CARGO_BUILD_JOBS=2

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY tools ./tools
COPY benchmark/fs-bench-pro/Cargo.toml ./benchmark/fs-bench-pro/Cargo.toml

# Docker COPY preserves source mtimes, which can predate a shared Cargo target.
# Refresh owned inputs whenever this RUN executes; registry dependencies stay cached.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,id=layerfs-bench-rust-1.85.1-${TARGETARCH},target=/src/target,sharing=locked \
    case "$CARGO_BUILD_JOBS" in \
      ''|*[!0-9]*) exit 1 ;; \
    esac \
 && test "$CARGO_BUILD_JOBS" -ge 1 \
 && test "$CARGO_BUILD_JOBS" -le 8 \
 && case "$TARGETARCH" in \
      arm64) target=aarch64-unknown-linux-gnu ;; \
      amd64) target=x86_64-unknown-linux-gnu ;; \
      *) exit 1 ;; \
    esac \
 && rustup target add "$target" \
 && find Cargo.toml Cargo.lock crates tools benchmark/fs-bench-pro -type f -exec touch {} + \
 && cargo build --locked --release --target "$target" --jobs "$CARGO_BUILD_JOBS" \
      -p layerfs-daemon --features test-instrumentation \
 && cargo build --locked --release --target "$target" --jobs "$CARGO_BUILD_JOBS" \
      -p layerfs-fuse --no-default-features --features proxy,test-instrumentation \
 && cp "target/$target/release/layerfs-daemon" /layerfs-daemon \
 && cp "target/$target/release/layerfs-fuse" /layerfs-fuse

ARG LAYERFS_SOURCE_COMMIT
ARG LAYERFS_SOURCE_TREE
ARG LAYERFS_SOURCE_DIRTY
ARG LAYERFS_SOURCE_SEAL
ARG LAYERFS_PRODUCT_SEAL
ARG WORKLOAD_SOURCE_SHA256

RUN test "${#LAYERFS_SOURCE_COMMIT}" -eq 40 \
 && test "${#LAYERFS_SOURCE_TREE}" -eq 40 \
 && test "${#LAYERFS_SOURCE_SEAL}" -eq 64 \
 && test "${#LAYERFS_PRODUCT_SEAL}" -eq 64 \
 && test "${#WORKLOAD_SOURCE_SHA256}" -eq 64 \
 && echo "$WORKLOAD_SOURCE_SHA256  /src/benchmark/fs-bench-pro/workload/main.rs" | sha256sum -c - \
 && case "$LAYERFS_SOURCE_DIRTY" in true|false) ;; *) exit 1 ;; esac \
 && case "$LAYERFS_SOURCE_COMMIT$LAYERFS_SOURCE_TREE$LAYERFS_SOURCE_SEAL" in *[!0-9a-f]*) exit 1 ;; esac


FROM build AS runtime-check

# Explicit component checks; this stage never starts a Store or benchmark.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,id=layerfs-bench-rust-1.85.1-${TARGETARCH},target=/src/target,sharing=locked \
    find Cargo.toml Cargo.lock crates tools benchmark/fs-bench-pro -type f -exec touch {} + \
 && cargo test --locked --jobs 2 -p layerfs-daemon --features test-instrumentation \
      --bin layerfs-daemon \
 && cargo check --locked --jobs 2 -p layerfs-workspace --features host-fuse \
 && cargo test --locked --jobs 2 -p layerfs-fuse --features proxy,live,test-instrumentation \
      --test proxy owned_write_reply_releases_receive_loop_and_completes_once \
 && cargo test --locked --jobs 2 -p layerfs-fuse --features proxy,live,test-instrumentation \
      --lib

FROM rust:1.85.1-bookworm@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4


RUN mkdir -p /run/layerfs /workspace /var/tmp/layerfs-owned /var/lib/fs-bench \
 && chmod 0700 /run/layerfs

COPY --from=build /fs-benchmark-workload /usr/local/bin/fs-benchmark-workload
COPY --from=build /layerfs-daemon /usr/local/bin/layerfs-daemon
COPY --from=build /layerfs-fuse /usr/local/bin/layerfs-fuse
COPY benchmark/fs-bench-pro/shared/daemon-entrypoint.sh /usr/local/bin/layerfs-daemon-entrypoint
ARG LAYERFS_BUILD_SELF_CHECK=1
RUN chmod 0555 /usr/local/bin/fs-benchmark-workload \
                  /usr/local/bin/layerfs-daemon \
                  /usr/local/bin/layerfs-fuse /usr/local/bin/layerfs-daemon-entrypoint \
 && if [ "$LAYERFS_BUILD_SELF_CHECK" = 1 ]; then /usr/local/bin/fs-benchmark-workload self-check; else test "$LAYERFS_BUILD_SELF_CHECK" = 0; fi \
 && test -x /usr/local/bin/layerfs-daemon

ARG LAYERFS_SOURCE_COMMIT
ARG LAYERFS_SOURCE_TREE
ARG LAYERFS_SOURCE_DIRTY
ARG LAYERFS_SOURCE_SEAL
ARG LAYERFS_PRODUCT_SEAL
ARG WORKLOAD_SOURCE_SHA256
ARG LAYERFS_COMPILATION_SEAL

LABEL org.opencontainers.image.source="https://github.com/Ephemeral-AI-Lab/layerfs" \
      org.opencontainers.image.revision="$LAYERFS_SOURCE_COMMIT" \
      org.opencontainers.image.source-tree="$LAYERFS_SOURCE_TREE" \
      dev.layerfs.source-dirty="$LAYERFS_SOURCE_DIRTY" \
      dev.layerfs.source-seal="$LAYERFS_SOURCE_SEAL" \
      dev.layerfs.product-seal="$LAYERFS_PRODUCT_SEAL" \
      dev.layerfs.compilation-seal="$LAYERFS_COMPILATION_SEAL" \
      dev.layerfs.workload-source-sha256="$WORKLOAD_SOURCE_SHA256"

ENV LAYERFS_SOURCE_COMMIT="$LAYERFS_SOURCE_COMMIT" \
    LAYERFS_SOURCE_TREE="$LAYERFS_SOURCE_TREE" \
    LAYERFS_SOURCE_DIRTY="$LAYERFS_SOURCE_DIRTY" \
    LAYERFS_SOURCE_SEAL="$LAYERFS_SOURCE_SEAL" \
    LAYERFS_FUSE_HELPER="/usr/local/bin/layerfs-fuse" \
    LAYERFS_FUSE_HOST="host.docker.internal" \
    LAYERFS_DAEMON_TCP_LISTEN="0.0.0.0:41273"

EXPOSE 41273/tcp

ENTRYPOINT ["/usr/local/bin/layerfs-daemon-entrypoint"]
