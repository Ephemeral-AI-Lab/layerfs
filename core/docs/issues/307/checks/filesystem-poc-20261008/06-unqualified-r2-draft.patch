index 000000000..cc8f5bfe7
--- /dev/null
+++ b/core/crates/layerfs-daemon/src/native/records.rs
@@ -0,0 +1,170 @@
+//! Indexed kernel references and directory cookies under one mount owner.
+use super::{
+    attributes,
+    context::{job, Context},
+    worker::{NativeFailure, Result},
+};
+use crate::{Command, Response};
+use layerfs_overlay::{
+    IndexedOperationRecordChange as Change, IndexedOperationRecordKey as Key,
+    IndexedOperationRecordScope as Scope, OperationRecordExpectedValue as Expected,
+};
+use layerfs_workspace::{OperationRecordApply, OverlayOperationRecords, ViewStat};
+fn key(kind: u32, id: u64) -> Key {
+    let mut key = [0; 32];
+    key[24..].copy_from_slice(&id.to_be_bytes());
+    Key { kind, key }
+}
+impl Context<'_> {
+    fn scope(&self, file_scope: u64) -> Scope {
+        Scope {
+            owner: self.state.records,
+            file_scope,
+        }
+    }
+    pub fn get(&self, scope: u64, kind: u32, id: u64) -> Result<Option<Vec<u8>>> {
+        self.call(
+            self.operation
+                .overlay()
+                .operation_record_get(self.scope(scope), key(kind, id)),
+        )
+        .map(|r| r.value)
+    }
+    pub fn put(
+        &self,
+        scope: u64,
+        kind: u32,
+        id: u64,
+        old: Option<Vec<u8>>,
+        value: Option<Vec<u8>>,
+    ) -> Result<()> {
+        let change = Change {
+            key: key(kind, id),
+            expected: old.map_or(Expected::Missing, Expected::ExactBytes),
+            value,
+        };
+        let result = self.call(
+            self.operation
+                .overlay()
+                .operation_record_apply(self.scope(scope), vec![change]),
+        )?;
+        match result.value {
+            OperationRecordApply::Applied => Ok(()),
+            OperationRecordApply::NotApplied { original, .. } => self.call(Err(original)),
+        }
+    }
+    pub fn lookup(&self, stat: &ViewStat) -> Result<()> {
+        let old = self.get(0, 1, stat.serial)?;
+        let (request, count) = match &old {
+            Some(bytes) if bytes.len() == 16 => (
+                number(&bytes[..8])?,
+                number(&bytes[8..])?
+                    .checked_add(1)
+                    .ok_or(NativeFailure::Invalid("lookup count overflow"))?,
+            ),
+            Some(_) => return Err(NativeFailure::Invalid("lookup record")),
+            None => {
+                self.acquire_lookup(stat, self.id)?;
+                (self.id, 1)
+            }
+        };
+        let mut value = request.to_be_bytes().to_vec();
+        value.extend_from_slice(&count.to_be_bytes());
+        self.put(0, 1, stat.serial, old, Some(value))
+    }
+    fn acquire_lookup(&self, stat: &ViewStat, id: u64) -> Result<()> {
+        let done = job(
+            &self.operation,
+            Command::AcquireLookup {
+                source: self.view.source(),
+                request: id,
+                base: attributes::base(stat),
+                root: self.state.root,
+            },
+        )?;
+        match done.result() {
+            Ok(Response::Lookup(Some(_))) => Ok(()),
+            _ => Err(NativeFailure::Completion(Box::new(done))),
+        }
+    }
+    fn release_lookup(&self, request: u64) -> Result<()> {
+        let done = job(&self.operation, Command::RetainedLookup { request })?;
+        let owner = match done.result() {
+            Ok(Response::Lookup(Some(owner))) => *owner,
+            _ => return Err(NativeFailure::Completion(Box::new(done))),
+        };
+        self.done(Command::ReleaseLookup(owner))
+    }
+    pub fn forget(&self, serial: u64, count: u64) -> Result<()> {
+        let old = self
+            .get(0, 1, serial)?
+            .ok_or(NativeFailure::Invalid("unknown lookup forget"))?;
+        if old.len() != 16 {
+            return Err(NativeFailure::Invalid("lookup record"));
+        }
+        let held = number(&old[8..])?;
+        let remaining = held
+            .checked_sub(count)
+            .ok_or(NativeFailure::Invalid("lookup forget underflow"))?;
+        if remaining == 0 {
+            self.release_lookup(number(&old[..8])?)?;
+            self.put(0, 1, serial, Some(old), None)
+        } else {
+            let mut next = old[..8].to_vec();
+            next.extend_from_slice(&remaining.to_be_bytes());
+            self.put(0, 1, serial, Some(old), Some(next))
+        }
+    }
+    pub fn open_directory(&self, stat: &ViewStat) -> Result<()> {
+        self.acquire_lookup(stat, self.id)?;
+        self.put(
+            0,
+            2,
+            self.id,
+            None,
+            Some(stat.serial.to_be_bytes().to_vec()),
+        )
+    }
+    pub fn directory(&self, fh: u64, serial: u64) -> Result<()> {
+        if self.get(0, 2, fh)?.as_deref() == Some(serial.to_be_bytes().as_slice()) {
+            Ok(())
+        } else {
+            Err(NativeFailure::Invalid("directory handle association"))
+        }
+    }
+    pub fn close_directory(&self, fh: u64, serial: u64) -> Result<()> {
+        self.directory(fh, serial)?;
+        self.release_lookup(fh)?;
+        self.put(0, 2, fh, Some(serial.to_be_bytes().to_vec()), None)
+    }
+    pub fn drain_lookups(&self) -> Result<()> {
+        loop {
+            let keys = self
+                .call(
+                    self.operation
+                        .overlay()
+                        .operation_record_keys(self.scope(0), 1, None),
+                )?
+                .value;
+            if keys.is_empty() {
+                break;
+            }
+            for key in keys {
+                let serial = number(&key[24..])?;
+                let bytes = self
+                    .get(0, 1, serial)?
+                    .ok_or(NativeFailure::Invalid("lookup drain"))?;
+                if bytes.len() != 16 {
+                    return Err(NativeFailure::Invalid("lookup record"));
+                }
+                self.forget(serial, number(&bytes[8..])?)?;
+            }
+        }
+        Ok(())
+    }
+}
+fn number(bytes: &[u8]) -> Result<u64> {
+    Ok(u64::from_be_bytes(bytes.try_into().map_err(|_| {
+        NativeFailure::Invalid("native integer record")
+    })?))
+}
diff --git a/core/crates/layerfs-daemon/src/native/worker.rs b/core/crates/layerfs-daemon/src/native/worker.rs
new file mode 100644
index 000000000..63662ec6b
--- /dev/null
+++ b/core/crates/layerfs-daemon/src/native/worker.rs
@@ -0,0 +1,118 @@
+//! Fixed request service, separate from the kernel receiver threads.
+use super::context::Context;
+use crate::{
+    store::{BoundWorkspace, PortError},
+    Completion, OwnerError,
+};
+use layerfs_workspace::WorkspaceError;
+use std::{
+    io,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        mpsc::{self, SyncSender},
+        Arc, Mutex,
+    },
+    thread::{self, JoinHandle},
+};
+
+#[derive(Debug)]
+pub enum NativeFailure {
+    Workspace {
+        cause: WorkspaceError,
+        provider: Option<Arc<PortError>>,
+    },
+    Owner(OwnerError),
+    Completion(Box<Completion>),
+    Invalid(&'static str),
+    Io(io::Error),
+}
+pub(super) type Result<T> = std::result::Result<T, NativeFailure>;
+pub(super) type Job = Box<dyn FnOnce(&mut State) + Send>;
+pub(super) struct State {
+    pub workspace: Arc<BoundWorkspace>,
+    pub root: u64,
+    pub uid: u32,
+    pub gid: u32,
+    pub records: layerfs_overlay::OperationOwner,
+    pub failure: Arc<Mutex<Option<NativeFailure>>>,
+}
+#[derive(Clone)]
+pub(super) struct Adapter {
+    pub sender: SyncSender<Job>,
+    pub sequence: Arc<AtomicU64>,
+}
+impl Adapter {
+    pub fn submit(&self, job: impl FnOnce(&mut State, u64) + Send + 'static) {
+        let id = self.sequence.fetch_add(1, Ordering::Relaxed);
+        // Admission backpressure precedes any Workspace operation. Each queued
+        // job owns its reply and at most one 128 KiB request window.
+        let _ = self.sender.send(Box::new(move |state| job(state, id)));
+    }
+}
+impl State {
+    pub fn fault(&self, error: NativeFailure) -> fuser::Errno {
+        if let NativeFailure::Workspace { cause, .. } = &error {
+            use layerfs_content::ContentError;
+            use layerfs_workspace::{Refusal as R, WorkspaceError as E};
+            let errno = match cause {
+                E::Content(ContentError::PathNotFound) | E::Refused(R::Missing) => {
+                    Some(fuser::Errno::ENOENT)
+                }
+                E::Refused(R::Exists) => Some(fuser::Errno::EEXIST),
+                E::Refused(R::NotDirectory) => Some(fuser::Errno::ENOTDIR),
+                E::Refused(R::IsDirectory) => Some(fuser::Errno::EISDIR),
+                E::Refused(R::NotPermitted) => Some(fuser::Errno::EPERM),
+                E::Refused(R::Invalid) => Some(fuser::Errno::EINVAL),
+                _ => None,
+            };
+            if let Some(errno) = errno {
+                return errno;
+            }
+        }
+        if let Ok(mut first) = self.failure.lock() {
+            if first.is_none() {
+                *first = Some(error);
+            }
+        }
+        fuser::Errno::EIO
+    }
+    pub fn serial(&self, ino: fuser::INodeNo) -> u64 {
+        if ino.0 == 1 {
+            self.root
+        } else if ino.0 == self.root {
+            1
+        } else {
+            ino.0
+        }
+    }
+    pub fn inode(&self, serial: u64) -> fuser::INodeNo {
+        fuser::INodeNo(if serial == self.root {
+            1
+        } else if serial == 1 {
+            self.root
+        } else {
+            serial
+        })
+    }
+    pub fn context(&self, id: u64) -> Result<Context<'_>> {
+        Context::new(self, id)
+    }
+}
+pub(super) fn start(state: State) -> io::Result<(Adapter, JoinHandle<()>)> {
+    let (sender, receiver) = mpsc::sync_channel::<Job>(8);
+    let worker = thread::Builder::new()
+        .name("layerfs-native-service".into())
+        .spawn(move || {
+            let mut state = state;
+            while let Ok(job) = receiver.recv() {
+                job(&mut state);
+            }
+        })?;
+    Ok((
+        Adapter {
+            sender,
+            sequence: Arc::new(AtomicU64::new(2)),
+        },
+        worker,
+    ))
+}
