diff --git a/core/crates/layerfs-daemon/src/native/mount.rs b/core/crates/layerfs-daemon/src/native/mount.rs
new file mode 100644
index 000000000..eea1daf15
--- /dev/null
+++ b/core/crates/layerfs-daemon/src/native/mount.rs
@@ -0,0 +1,217 @@
+//! First-party mount ownership: plain busy-preserving detach, no Drop unmount.
+use super::{
+    context::job,
+    worker::{self, Adapter, NativeFailure, State},
+};
+use crate::{store::BoundWorkspace, Command, Response};
+use fuser::{Config, Session, SessionACL};
+use nix::mount::{mount, umount, MsFlags};
+use std::{
+    fs::{self, File, OpenOptions},
+    io,
+    os::fd::AsRawFd,
+    path::{Path, PathBuf},
+    sync::{mpsc, Arc, Mutex},
+    thread::{self, JoinHandle},
+};
+pub struct NativeMount {
+    path: PathBuf,
+    device: Option<File>,
+    adapter: Option<Adapter>,
+    session: Option<JoinHandle<io::Result<()>>>,
+    worker: Option<JoinHandle<()>>,
+    failure: Arc<Mutex<Option<NativeFailure>>>,
+    attached: bool,
+    detached: bool,
+}
+pub struct AttachFailure {
+    pub cause: io::Error,
+    /// Some after kernel mount effect: caller retains the original owner.
+    pub mount: Option<Box<NativeMount>>,
+}
+impl std::fmt::Debug for AttachFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("AttachFailure")
+            .field("cause", &self.cause)
+            .field("retained_mount", &self.mount.is_some())
+            .finish()
+    }
+}
+impl std::fmt::Display for AttachFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "native attachment: {self:?}")
+    }
+}
+impl std::error::Error for AttachFailure {}
+impl NativeMount {
+    /// The caller supplies an empty, protected mountpoint and the command UID/GID.
+    /// A successful return includes one actual kernel root getattr round trip.
+    /// It does not assert complete two-loop S8 readiness or failure-path drain.
+    pub fn attach(
+        workspace: Arc<BoundWorkspace>,
+        path: &Path,
+        uid: u32,
+        gid: u32,
+    ) -> Result<Self, AttachFailure> {
+        let before = |cause| AttachFailure { cause, mount: None };
+        if uid == 0 || gid == 0 {
+            return Err(before(io::Error::other(
+                "ordinary command identity required",
+            )));
+        }
+        let operation = workspace
+            .operation()
+            .map_err(|e| before(io::Error::other(e)))?;
+        let root = operation
+            .workspace()
+            .base()
+            .map_err(|e| before(io::Error::other(e)))?
+            .root()
+            .root_inode()
+            .serial();
+        let device = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open("/dev/fuse")
+            .map_err(before)?;
+        let session_device = device.try_clone().map_err(before)?;
+        let done = job(&operation, Command::AcquireOperation { request: 1 })
+            .map_err(|e| before(io::Error::other(format!("{e:?}"))))?;
+        let records = match done.result() {
+            Ok(Response::Operation(Some(owner))) => *owner,
+            _ => return Err(before(io::Error::other(format!("{done:?}")))),
+        };
+        let failure = Arc::new(Mutex::new(None));
+        let state = State {
+            workspace,
+            root,
+            uid,
+            gid,
+            records,
+            failure: failure.clone(),
+        };
+        let (adapter, worker) = worker::start(state).map_err(before)?;
+        let mut owned = Self {
+            path: path.to_owned(),
+            device: Some(device),
+            adapter: Some(adapter),
+            session: None,
+            worker: Some(worker),
+            failure,
+            attached: false,
+            detached: false,
+        };
+        let options=format!("fd={},rootmode=40000,user_id=0,group_id=0,allow_other,default_permissions,max_read=131072",owned.device.as_ref().expect("device owner").as_raw_fd());
+        if let Err(e) = mount(
+            Some("layerfs"),
+            path,
+            Some("fuse"),
+            MsFlags::MS_NOSUID | MsFlags::MS_NODEV | MsFlags::MS_NOATIME,
+            Some(options.as_str()),
+        ) {
+            return Err(AttachFailure {
+                cause: e.into(),
+                mount: Some(Box::new(owned)),
+            });
+        }
+        owned.attached = true;
+        let mut config = Config::default();
+        config.acl = SessionACL::All;
+        config.n_threads = Some(2);
+        config.clone_fd = false;
+        let fs = owned.adapter.as_ref().expect("adapter owner").clone();
+        let (ready, received) = mpsc::sync_channel(1);
+        let session = thread::Builder::new()
+            .name("layerfs-native-session".into())
+            .spawn(move || {
+                let session = Session::from_fd(fs, session_device.into(), SessionACL::All, config);
+                let _ = ready.send(session.is_ok());
+                session?.run()
+            });
+        match session {
+            Ok(thread) => owned.session = Some(thread),
+            Err(cause) => {
+                return Err(AttachFailure {
+                    cause,
+                    mount: Some(Box::new(owned)),
+                })
+            }
+        }
+        if received.recv() != Ok(true) {
+            return Err(AttachFailure {
+                cause: io::Error::other("native handshake failed; original session retained"),
+                mount: Some(Box::new(owned)),
+            });
+        }
+        let probe = fs::metadata(path);
+        if let Err(cause) = probe {
+            return Err(AttachFailure {
+                cause,
+                mount: Some(Box::new(owned)),
+            });
+        }
+        Ok(owned)
+    }
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+    pub fn failure(
+        &self,
+    ) -> std::sync::LockResult<std::sync::MutexGuard<'_, Option<NativeFailure>>> {
+        self.failure.lock()
+    }
+    /// Normal kernel busy refusal leaves this mount and its service usable.
+    /// No command process is signalled. A failed drain retains the owner.
+    pub fn detach(&mut self) -> io::Result<()> {
+        if !self.detached && self.attached {
+            umount(&self.path)?;
+            self.detached = true;
+        }
+        if let Some(session) = self.session.take() {
+            session.join().map_err(|_| {
+                io::Error::other("native session panicked; complete receiver drain unproven")
+            })??;
+        }
+        if let Some(adapter) = self.adapter.as_ref() {
+            let (sent, received) = mpsc::sync_channel(1);
+            adapter.submit(move |state, id| {
+                let result = (|| {
+                    let ctx = state.context(id)?;
+                    let result = ctx
+                        .drain_lookups()
+                        .and_then(|_| ctx.done(Command::ReleaseOperation(state.records)));
+                    ctx.finish();
+                    result
+                })();
+                let ok = result.is_ok();
+                if let Err(e) = result {
+                    state.fault(e);
+                }
+                let _ = sent.send(ok);
+            });
+            if received.recv() != Ok(true) {
+                return Err(io::Error::other(
+                    "native custody drain failed; original failure retained",
+                ));
+            }
+        }
+        self.adapter.take();
+        if let Some(worker) = self.worker.take() {
+            worker
+                .join()
+                .map_err(|_| io::Error::other("native service panicked"))?;
+        }
+        if self
+            .failure
+            .lock()
+            .map_err(|_| io::Error::other("native failure lock poisoned"))?
+            .is_some()
+        {
+            return Err(io::Error::other(
+                "native request failed; original receipt retained",
+            ));
+        }
+        self.device.take();
+        Ok(())
+    }
+}
diff --git a/core/crates/layerfs-daemon/src/native/records.rs b/core/crates/layerfs-daemon/src/native/records.rs
