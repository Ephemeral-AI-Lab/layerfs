index 000000000..bd591b375
--- /dev/null
+++ b/core/crates/layerfs-daemon/src/native/attributes.rs
@@ -0,0 +1,86 @@
+//! Portable inode projection; the kernel enforces the admitted command identity.
+use super::worker::State;
+use fuser::{FileAttr, FileType};
+use layerfs_content::object::inode_leaf::InodeKind;
+use layerfs_workspace::{Time, ViewStat};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+pub(super) const TTL: Duration = Duration::from_secs(60);
+pub(super) fn kind(kind: InodeKind) -> FileType {
+    match kind {
+        InodeKind::RegularFile => FileType::RegularFile,
+        InodeKind::Directory => FileType::Directory,
+        InodeKind::Symlink => FileType::Symlink,
+    }
+}
+pub(super) fn time(seconds: i64, nanos: u32) -> SystemTime {
+    if seconds >= 0 {
+        UNIX_EPOCH + Duration::new(seconds as u64, nanos)
+    } else {
+        UNIX_EPOCH - Duration::from_secs(seconds.unsigned_abs())
+            + Duration::from_nanos(nanos.into())
+    }
+}
+pub(super) fn portable(time: SystemTime) -> Time {
+    match time.duration_since(UNIX_EPOCH) {
+        Ok(d) => Time {
+            seconds: d.as_secs() as i64,
+            nanoseconds: d.subsec_nanos(),
+        },
+        Err(e) => {
+            let d = e.duration();
+            if d.subsec_nanos() == 0 {
+                Time {
+                    seconds: -(d.as_secs() as i64),
+                    nanoseconds: 0,
+                }
+            } else {
+                Time {
+                    seconds: -(d.as_secs() as i64) - 1,
+                    nanoseconds: 1_000_000_000 - d.subsec_nanos(),
+                }
+            }
+        }
+    }
+}
+pub(super) fn attr(state: &State, stat: &ViewStat) -> FileAttr {
+    let mtime = time(stat.metadata.mtime_seconds, stat.metadata.mtime_nanoseconds);
+    FileAttr {
+        ino: state.inode(stat.serial),
+        size: stat.logical_len,
+        blocks: stat.logical_len.div_ceil(512),
+        atime: mtime,
+        mtime,
+        ctime: mtime,
+        crtime: UNIX_EPOCH,
+        kind: kind(stat.kind),
+        perm: stat.metadata.mode as u16,
+        nlink: if stat.kind == InodeKind::Directory {
+            2
+        } else {
+            stat.namespace_refs as u32
+        },
+        uid: state.uid,
+        gid: state.gid,
+        rdev: 0,
+        blksize: 4096,
+        flags: 0,
+    }
+}
+pub(super) fn base(stat: &ViewStat) -> layerfs_overlay::Inode {
+    layerfs_overlay::Inode {
+        serial: stat.serial,
+        kind: match stat.kind {
+            InodeKind::RegularFile => layerfs_overlay::InodeKind::File,
+            InodeKind::Directory => layerfs_overlay::InodeKind::Directory,
+            InodeKind::Symlink => layerfs_overlay::InodeKind::Symlink,
+        },
+        mode: stat.metadata.mode as u16,
+        mtime_seconds: stat.metadata.mtime_seconds,
+        mtime_nanoseconds: stat.metadata.mtime_nanoseconds,
+        nlink: stat.namespace_refs,
+        size: stat.logical_len,
+        inherited_cutoff: stat.logical_len,
+        born: 0,
+        entries: 0,
+    }
+}
diff --git a/core/crates/layerfs-daemon/src/native/callbacks.rs b/core/crates/layerfs-daemon/src/native/callbacks.rs
new file mode 100644
index 000000000..140e0c120
--- /dev/null
+++ b/core/crates/layerfs-daemon/src/native/callbacks.rs
@@ -0,0 +1,405 @@
+//! Kernel callback admission and one owned reply attempt per request.
+use super::{
+    attributes::{attr, kind, portable, TTL},
+    worker::Adapter,
+};
+use fuser::*;
+use layerfs_content::filesystem::PathName;
+use layerfs_workspace::{Operation, Position};
+use std::{ffi::OsStr, os::unix::ffi::OsStrExt, time::SystemTime};
+macro_rules! context {
+    ($state:ident,$id:ident,$reply:ident) => {
+        match $state.context($id) {
+            Ok(ctx) => ctx,
+            Err(e) => {
+                $reply.error($state.fault(e));
+                return;
+            }
+        }
+    };
+}
+fn name(name: &OsStr) -> std::result::Result<PathName, Errno> {
+    PathName::new(name.as_bytes().to_vec()).map_err(|_| Errno::EINVAL)
+}
+impl Filesystem for Adapter {
+    fn init(&mut self, _: &Request, config: &mut KernelConfig) -> std::io::Result<()> {
+        config
+            .set_max_write(128 * 1024)
+            .map_err(|_| std::io::Error::other("128 KiB write unavailable"))?;
+        config
+            .set_max_readahead(128 * 1024)
+            .map_err(|_| std::io::Error::other("128 KiB readahead unavailable"))?;
+        config
+            .set_max_background(1)
+            .map_err(|_| std::io::Error::other("background limit"))?;
+        config
+            .set_congestion_threshold(1)
+            .map_err(|_| std::io::Error::other("congestion limit"))?;
+        Ok(())
+    }
+    fn lookup(&self, _: &Request, parent: INodeNo, raw: &OsStr, reply: ReplyEntry) {
+        let name = match name(raw) {
+            Ok(v) => v,
+            Err(e) => {
+                reply.error(e);
+                return;
+            }
+        };
+        self.submit(move |state, id| {
+            let ctx = context!(state, id, reply);
+            let result = ctx
+                .call(
+                    ctx.view
+                        .lookup(ctx.operation.overlay(), state.serial(parent), &name),
+                )
+                .and_then(|stat| {
+                    ctx.lookup(&stat)?;
+                    Ok(attr(state, &stat))
+                });
+            match result {
+                Ok(a) => reply.entry(&TTL, &a, Generation(0)),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn forget(&self, _: &Request, ino: INodeNo, nlookup: u64) {
+        self.submit(move |state, id| match state.context(id) {
+            Ok(ctx) => {
+                if let Err(e) = ctx.forget(state.serial(ino), nlookup) {
+                    state.fault(e);
+                }
+                ctx.finish();
+            }
+            Err(e) => {
+                state.fault(e);
+            }
+        });
+    }
+    fn getattr(&self, _: &Request, ino: INodeNo, _: Option<FileHandle>, reply: ReplyAttr) {
+        self.submit(move |state, id| {
+            let ctx = context!(state, id, reply);
+            match ctx.stat(state.serial(ino)) {
+                Ok(stat) => reply.attr(&TTL, &attr(state, &stat)),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn readlink(&self, _: &Request, ino: INodeNo, reply: ReplyData) {
+        self.submit(move |state, id| {
+            let ctx = context!(state, id, reply);
+            match ctx.call(
+                ctx.view
+                    .readlink(ctx.operation.overlay(), state.serial(ino)),
+            ) {
+                Ok(link) => reply.data(link.as_bytes()),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn open(&self, _: &Request, ino: INodeNo, flags: OpenFlags, reply: ReplyOpen) {
+        self.submit(move |state, id| {
+            let ctx = context!(state, id, reply);
+            let result = ctx
+                .stat(state.serial(ino))
+                .and_then(|stat| ctx.open(&stat, flags.acc_mode() != OpenAccMode::O_RDONLY));
+            match result {
+                Ok(()) => reply.opened(FileHandle(id), FopenFlags::FOPEN_KEEP_CACHE),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn read(
+        &self,
+        _: &Request,
+        ino: INodeNo,
+        fh: FileHandle,
+        offset: u64,
+        size: u32,
+        _: OpenFlags,
+        _: Option<LockOwner>,
+        reply: ReplyData,
+    ) {
+        if size > 128 * 1024 {
+            reply.error(Errno::EINVAL);
+            return;
+        }
+        self.submit(move |state, id| {
+            let mut ctx = context!(state, id, reply);
+            let result = ctx
+                .file(fh.0, state.serial(ino))
+                .and_then(|file| ctx.read(file, offset, size));
+            match result {
+                Ok(data) => reply.data(&data),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn write(
+        &self,
+        _: &Request,
+        ino: INodeNo,
+        fh: FileHandle,
+        offset: u64,
+        data: &[u8],
+        flags: WriteFlags,
+        open_flags: OpenFlags,
+        _: Option<LockOwner>,
+        reply: ReplyWrite,
+    ) {
+        if data.len() > 128 * 1024 || !flags.is_empty() {
+            reply.error(Errno::EINVAL);
+            return;
+        }
+        let data = layerfs_workspace::WriteData::from(data);
+        let length = data.len() as u32;
+        self.submit(move |state, id| {
+            let mut ctx = context!(state, id, reply);
+            let result = ctx.file(fh.0, state.serial(ino)).and_then(|file| {
+                ctx.mutate(Operation::WriteOpen {
+                    file,
+                    position: if open_flags.0 & nix::libc::O_APPEND != 0 {
+                        Position::End
+                    } else {
+                        Position::At(offset)
+                    },
+                    data,
+                })
+            });
+            match result {
+                Ok(_) => reply.written(length),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn setattr(
+        &self,
+        _: &Request,
+        ino: INodeNo,
+        mode: Option<u32>,
+        uid: Option<u32>,
+        gid: Option<u32>,
+        size: Option<u64>,
+        _: Option<TimeOrNow>,
+        mtime: Option<TimeOrNow>,
+        _: Option<SystemTime>,
+        fh: Option<FileHandle>,
+        _: Option<SystemTime>,
+        _: Option<SystemTime>,
+        _: Option<SystemTime>,
+        flags: Option<BsdFileFlags>,
+        reply: ReplyAttr,
+    ) {
+        if uid.is_some() || gid.is_some() || flags.is_some() {
+            reply.error(Errno::EOPNOTSUPP);
+            return;
+        }
+        let mtime = mtime.map(|t| {
+            portable(match t {
+                TimeOrNow::SpecificTime(t) => t,
+                TimeOrNow::Now => SystemTime::now(),
+            })
+        });
+        self.submit(move |state, id| {
+            let mut ctx = context!(state, id, reply);
+            let serial = state.serial(ino);
+            let operation = match fh {
+                Some(fh) => ctx
+                    .file(fh.0, serial)
+                    .map(|file| Operation::SetOpenAttributes {
+                        file,
+                        mode,
+                        mtime,
+                        size,
+                    }),
+                None => Ok(Operation::SetAttributes {
+                    serial,
+                    mode,
+                    mtime,
+                    size,
+                }),
+            };
+            let result = operation
+                .and_then(|op| ctx.mutate(op))
+                .and_then(|_| ctx.stat(serial));
+            match result {
+                Ok(stat) => reply.attr(&TTL, &attr(state, &stat)),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn create(
+        &self,
+        _: &Request,
+        parent: INodeNo,
+        raw: &OsStr,
+        mode: u32,
+        umask: u32,
+        flags: OpenFlags,
+        reply: ReplyCreate,
+    ) {
+        let name = match name(raw) {
+            Ok(v) => v,
+            Err(e) => {
+                reply.error(e);
+                return;
+            }
+        };
+        self.submit(move |state, id| {
+            let mut ctx = context!(state, id, reply);
+            let result = ctx
+                .mutate(Operation::Create {
+                    parent: state.serial(parent),
+                    name,
+                    mode: (mode & 0o777) & !umask,
+                })
+                .and_then(|stat| stat.ok_or(super::worker::NativeFailure::Invalid("create stat")))
+                .and_then(|stat| {
+                    ctx.open(&stat, flags.acc_mode() != OpenAccMode::O_RDONLY)?;
+                    ctx.lookup(&stat)?;
+                    Ok(attr(state, &stat))
+                });
+            match result {
+                Ok(a) => reply.created(
+                    &TTL,
+                    &a,
+                    Generation(0),
+                    FileHandle(id),
+                    FopenFlags::FOPEN_KEEP_CACHE,
+                ),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn flush(&self, _: &Request, ino: INodeNo, fh: FileHandle, _: LockOwner, reply: ReplyEmpty) {
+        self.submit(move |state, id| {
+            let ctx = context!(state, id, reply);
+            match ctx.file(fh.0, state.serial(ino)) {
+                Ok(_) => reply.ok(),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn release(
+        &self,
+        _: &Request,
+        ino: INodeNo,
+        fh: FileHandle,
+        _: OpenFlags,
+        _: Option<LockOwner>,
+        _: bool,
+        reply: ReplyEmpty,
+    ) {
+        self.submit(move |state, id| {
+            let ctx = context!(state, id, reply);
+            let result = ctx
+                .file(fh.0, state.serial(ino))
+                .and_then(|file| ctx.done(crate::Command::CloseFile(file)));
+            match result {
+                Ok(()) => reply.ok(),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn fsync(&self, req: &Request, ino: INodeNo, fh: FileHandle, _: bool, reply: ReplyEmpty) {
+        self.flush(req, ino, fh, LockOwner(0), reply);
+    }
+    fn opendir(&self, _: &Request, ino: INodeNo, _: OpenFlags, reply: ReplyOpen) {
+        self.submit(move |state, id| {
+            let ctx = context!(state, id, reply);
+            let result = ctx
+                .stat(state.serial(ino))
+                .and_then(|stat| ctx.open_directory(&stat));
+            match result {
+                Ok(()) => reply.opened(FileHandle(id), FopenFlags::empty()),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn readdir(
+        &self,
+        _: &Request,
+        ino: INodeNo,
+        fh: FileHandle,
+        offset: u64,
+        mut reply: ReplyDirectory,
+    ) {
+        self.submit(move |state, id| {
+            let ctx = context!(state, id, reply);
+            let serial = state.serial(ino);
+            let result =
+                (|| {
+                    ctx.directory(fh.0, serial)?;
+                    let mut after = if offset == 0 {
+                        None
+                    } else {
+                        Some(
+                            ctx.get(fh.0, 3, offset)?
+                                .ok_or(super::worker::NativeFailure::Invalid("directory cookie"))?,
+                        )
+                    };
+                    let mut cookie = offset;
+                    loop {
+                        let page = ctx.call(ctx.view.list(
+                            ctx.operation.overlay(),
+                            serial,
+                            after.as_deref(),
+                        ))?;
+                        for (name, serial) in page.entries {
+                            let stat = ctx.stat(serial)?;
+                            let next = cookie.checked_add(1).ok_or(
+                                super::worker::NativeFailure::Invalid("directory cookie exhausted"),
+                            )?;
+                            if reply.add(
+                                state.inode(serial),
+                                next,
+                                kind(stat.kind),
+                                OsStr::from_bytes(&name),
+                            ) {
+                                return Ok(());
+                            }
+                            let old = ctx.get(fh.0, 3, next)?;
+                            ctx.put(fh.0, 3, next, old, Some(name))?;
+                            cookie = next;
+                        }
+                        match page.continuation {
+                            Some(next) => after = Some(next),
+                            None => return Ok(()),
+                        }
+                    }
+                })();
+            match result {
+                Ok(()) => reply.ok(),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+    fn releasedir(
+        &self,
+        _: &Request,
+        ino: INodeNo,
+        fh: FileHandle,
+        _: OpenFlags,
+        reply: ReplyEmpty,
+    ) {
+        self.submit(move |state, id| {
+            let ctx = context!(state, id, reply);
+            match ctx.close_directory(fh.0, state.serial(ino)) {
+                Ok(()) => reply.ok(),
+                Err(e) => reply.error(state.fault(e)),
+            };
+            ctx.finish();
+        });
+    }
+}
diff --git a/core/crates/layerfs-daemon/src/native/context.rs b/core/crates/layerfs-daemon/src/native/context.rs
new file mode 100644
index 000000000..9642d3b11
--- /dev/null
+++ b/core/crates/layerfs-daemon/src/native/context.rs
@@ -0,0 +1,166 @@
+//! One request's source, descriptor-read and published-reply custody.
+use super::{
+    attributes,
+    worker::{NativeFailure, Result, State},
+};
+use crate::{store::StoreOperation, Command, Completion, OwnerError, Response};
+use layerfs_overlay::{BaseSource, FileRead, OpenFile, Publication};
+use layerfs_workspace::{Operation, Outcome, SourceView, ViewStat};
+pub(super) struct Context<'a> {
+    pub state: &'a State,
+    pub operation: StoreOperation,
+    pub view: SourceView,
+    pub id: u64,
+    source: BaseSource,
+    publication: Option<Publication>,
+    read: Option<FileRead>,
+}
+pub(super) fn job(operation: &StoreOperation, command: Command) -> Result<Completion> {
+    operation
+        .overlay()
+        .try_submit(Some(operation.workspace().route()), command)
+        .map_err(|(cause, command)| {
+            NativeFailure::Owner(OwnerError::Unattempted {
+                cause: Box::new(cause),
+                command: Box::new(command),
+            })
+        })?
+        .wait()
+        .map_err(NativeFailure::Owner)
+}
+impl<'a> Context<'a> {
+    pub fn new(state: &'a State, id: u64) -> Result<Self> {
+        if id == 0 || id > i64::MAX as u64 {
+            return Err(NativeFailure::Invalid("request identity exhausted"));
+        }
+        if state
+            .failure
+            .lock()
+            .map_err(|_| NativeFailure::Invalid("failure lock poisoned"))?
+            .is_some()
+        {
+            return Err(NativeFailure::Invalid(
+                "native owner retained an original failure",
+            ));
+        }
+        let operation = state
+            .workspace
+            .operation()
+            .map_err(|cause| NativeFailure::Workspace {
+                cause,
+                provider: None,
+            })?;
+        let done = job(&operation, Command::AcquireBaseSource { owner: id })?;
+        let source = match done.result() {
+            Ok(Response::BaseSource(source)) => *source,
+            _ => return Err(NativeFailure::Completion(Box::new(done))),
+        };
+        let view = operation
+            .workspace()
+            .view_for_source(source)
+            .map_err(|cause| NativeFailure::Workspace {
+                cause,
+                provider: None,
+            })?;
+        Ok(Self {
+            state,
+            operation,
+            view,
+            id,
+            source,
+            publication: None,
+            read: None,
+        })
+    }
+    pub fn call<T>(&self, result: layerfs_workspace::WorkspaceResult<T>) -> Result<T> {
+        result.map_err(|cause| NativeFailure::Workspace {
+            cause,
+            provider: self.operation.ports().failure().ok().flatten(),
+        })
+    }
+    pub fn done(&self, command: Command) -> Result<()> {
+        let done = job(&self.operation, command)?;
+        match done.result() {
+            Ok(Response::Done) => Ok(()),
+            _ => Err(NativeFailure::Completion(Box::new(done))),
+        }
+    }
+    pub fn stat(&self, serial: u64) -> Result<ViewStat> {
+        self.call(self.view.stat(self.operation.overlay(), serial))
+    }
+    pub fn file(&self, fh: u64, serial: u64) -> Result<OpenFile> {
+        let done = job(&self.operation, Command::RetainedFile { request: fh })?;
+        match done.result() {
+            Ok(Response::File(Some(file))) if file.serial() == serial => Ok(*file),
+            _ => Err(NativeFailure::Completion(Box::new(done))),
+        }
+    }
+    pub fn open(&self, stat: &ViewStat, writable: bool) -> Result<()> {
+        let done = job(
+            &self.operation,
+            Command::OpenFile {
+                source: self.source,
+                request: self.id,
+                base: attributes::base(stat),
+                writable,
+            },
+        )?;
+        match done.result() {
+            Ok(Response::File(Some(_))) => Ok(()),
+            _ => Err(NativeFailure::Completion(Box::new(done))),
+        }
+    }
+    pub fn read(&mut self, file: OpenFile, offset: u64, size: u32) -> Result<Vec<u8>> {
+        let done = job(
+            &self.operation,
+            Command::AcquireFileRead {
+                source: self.source,
+                file,
+                request: self.id,
+            },
+        )?;
+        let read = match done.result() {
+            Ok(Response::FileReader(Some(read))) => *read,
+            _ => return Err(NativeFailure::Completion(Box::new(done))),
+        };
+        self.read = Some(read);
+        let mut bytes = Vec::with_capacity(size as usize);
+        self.call(
+            self.view
+                .read_file(self.operation.overlay(), read, offset, size, &mut bytes),
+        )?;
+        Ok(bytes)
+    }
+    pub fn mutate(&mut self, operation: Operation) -> Result<Option<ViewStat>> {
+        let result = self.call(self.operation.workspace().mutate(
+            self.operation.overlay(),
+            self.operation.ports(),
+            &self.view,
+            operation,
+            attributes::portable(std::time::SystemTime::now()),
+        ))?;
+        match result {
+            Outcome::Applied { publication, stat } => {
+                self.publication = Some(publication);
+                Ok(stat)
+            }
+            Outcome::Unchanged { stat } => Ok(stat),
+        }
+    }
+    /// Called only after the one kernel reply attempt. Drop does no inferred SQL.
+    pub fn finish(mut self) {
+        if let Some(publication) = self.publication.take() {
+            if let Err(e) = self.done(Command::ReplyAttempted(publication)) {
+                self.state.fault(e);
+            }
+        }
+        if let Some(read) = self.read.take() {
+            if let Err(e) = self.done(Command::ReleaseFileRead(read)) {
+                self.state.fault(e);
+            }
+        }
+        if let Err(e) = self.done(Command::ReleaseBaseSource(self.source)) {
+            self.state.fault(e);
+        }
+    }
+}
