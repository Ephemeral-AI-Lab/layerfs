+//! One pull owner over the existing mux, with original runtime errors retained.
+use super::{super::RuntimeOutput, types::AdminStderr};
+use crate::RuntimeError;
+use std::io::{self, Read};
+pub(super) struct Input<'a> {
+    pub output: &'a mut RuntimeOutput,
+    pub stderr: &'a mut AdminStderr,
+    pub original: Option<RuntimeError>,
+    pub fence_error: Option<io::Error>,
+}
+impl Read for Input<'_> {
+    fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
+        if self.original.is_some() {
+            return Err(io::Error::other("terminal admin stdout owner"));
+        }
+        match self.output.read_stdout(out, self.stderr) {
+            Ok(n) => Ok(n),
+            Err(error) => {
+                self.original = Some(error.cause);
+                self.fence_error = error.fence_error;
+                Err(io::Error::other(
+                    "original admin runtime output failure retained",
+                ))
+            }
+        }
+    }
+}
diff --git a/core/crates/layerfs-sandbox/src/backend/docker/admin/metadata.rs b/core/crates/layerfs-sandbox/src/backend/docker/admin/metadata.rs
new file mode 100644
index 000000000..91cc62e3a
--- /dev/null
+++ b/core/crates/layerfs-sandbox/src/backend/docker/admin/metadata.rs
@@ -0,0 +1,166 @@
+//! Streamed selected ctr facts; unselected spec/env/output never becomes a resident document.
+use super::super::json::{once, Json};
+use super::types::{TargetObservation, VersionObservation};
+use crate::{ContainerId, RuntimeError};
+use std::io::Read;
+pub(super) const REVISION: &str = "193637f7ee8ae5f5aa5248f49e7baa3e6164966e";
+pub(super) fn version(
+    input: &mut impl Read,
+    observed: &mut VersionObservation,
+) -> Result<(), RuntimeError> {
+    let mut section = 0;
+    let mut bits = [0u8; 2];
+    loop {
+        let Some(line) = line(input)? else { break };
+        let line = line.trim();
+        if line.is_empty() {
+            continue;
+        }
+        if line == "Client:" {
+            if section != 0 {
+                return Err(RuntimeError::Protocol(
+                    "duplicate/misordered ctr client section",
+                ));
+            }
+            section = 1;
+            continue;
+        }
+        if line == "Server:" {
+            if section != 1 || bits[0] & 3 != 3 {
+                return Err(RuntimeError::Protocol("ctr server section"));
+            }
+            section = 2;
+            continue;
+        }
+        if section == 0 {
+            return Err(RuntimeError::Protocol("ctr version header"));
+        }
+        let (name, value) = line
+            .split_once(':')
+            .ok_or(RuntimeError::Protocol("ctr version field"))?;
+        let (bit, index) = match (section, name) {
+            (1, "Version") => (1, 0),
+            (1, "Revision") => (2, 1),
+            (1, "Go version") => (4, 5),
+            (2, "Version") => (1, 2),
+            (2, "Revision") => (2, 3),
+            (2, "UUID") => (4, 4),
+            _ => return Err(RuntimeError::Protocol("ctr version deciding field")),
+        };
+        once(&mut bits[section - 1], bit)?;
+        let value = Some(value.trim().to_owned());
+        match index {
+            0 => observed.client = value,
+            1 => observed.client_revision = value,
+            2 => observed.server = value,
+            3 => observed.server_revision = value,
+            4 => observed.server_uuid = value,
+            _ => (),
+        };
+    }
+    if bits != [7, 7] || !observed.server_uuid.as_deref().is_some_and(uuid) {
+        return Err(RuntimeError::Protocol(
+            "complete ctr/client/server version-revision-UUID fields",
+        ));
+    }
+    observed.complete = true;
+    Ok(())
+}
+
+fn line(input: &mut impl Read) -> Result<Option<String>, RuntimeError> {
+    let mut row = [0; 256];
+    let mut used = 0;
+    loop {
+        let mut byte = [0];
+        let n = input.read(&mut byte)?;
+        if n == 0 {
+            if used == 0 {
+                return Ok(None);
+            }
+            return Err(RuntimeError::Protocol("ctr version incomplete line"));
+        }
+        if byte[0] == b'\n' {
+            return Ok(Some(
+                std::str::from_utf8(&row[..used])
+                    .map_err(|_| RuntimeError::Protocol("ctr version UTF8"))?
+                    .into(),
+            ));
+        }
+        if used == row.len() {
+            return Err(RuntimeError::Protocol("ctr2.2.4 version field window"));
+        }
+        row[used] = byte[0];
+        used += 1;
+    }
+}
+fn uuid(s: &str) -> bool {
+    s.len() == 36
+        && s.bytes().enumerate().all(|(i, b)| {
+            if [8, 13, 18, 23].contains(&i) {
+                b == b'-'
+            } else {
+                b.is_ascii_digit() || (b'a'..=b'f').contains(&b)
+            }
+        })
+}
+pub(super) fn info(
+    input: &mut impl Read,
+    observed: &mut TargetObservation,
+) -> Result<(), RuntimeError> {
+    let mut json = Json::new(input);
+    let mut bits = 0;
+    json.object(|j, key| {
+        if key.equals("ID") {
+            once(&mut bits, 1)?;
+            let value = j.string(true)?;
+            if value.overflow {
+                return Err(RuntimeError::Protocol("ctr target identity width"));
+            }
+            observed.observed_container = Some(ContainerId::parse(value.text())?);
+        } else if key.equals("Extensions") {
+            once(&mut bits, 2)?;
+            observed.extensions_present = true;
+            if !j.null()? {
+                j.object(|j, key| {
+                    if key.equals("ctr.cni-containerd.metadata") {
+                        observed.cni_present = true;
+                    }
+                    j.skip(2)
+                })?;
+            }
+        } else if key.equals("Runtime") {
+            once(&mut bits, 4)?;
+            let mut selected = 0;
+            j.object(|j, key| {
+                if key.equals("Name") {
+                    once(&mut selected, 1)?;
+                    let value = j.string(true)?;
+                    if value.overflow {
+                        return Err(RuntimeError::Protocol("ctr runtime metadata field window"));
+                    }
+                    observed.runtime_name = Some(value.text().into());
+                } else {
+                    j.skip(2)?;
+                }
+                Ok(())
+            })?;
+            if selected != 1 {
+                return Err(RuntimeError::Protocol("ctr runtime Name missing"));
+            }
+        } else {
+            j.skip(1)?;
+        }
+        Ok(())
+    })?;
+    json.finish()?;
+    observed.complete = true;
+    if bits != 7 {
+        return Err(RuntimeError::Protocol("ctr target deciding fields missing"));
+    }
+    Ok(())
+}
+pub(super) fn drain(input: &mut impl Read) -> Result<(), RuntimeError> {
+    let mut bytes = [0; 8192];
+    while input.read(&mut bytes)? != 0 {}
+    Ok(())
+}
