+            ExecRequest {
+                identity: CommandIdentity { uid: 501, gid: 20 },
+                arguments: vec!["bash".into()],
+                environment: vec![],
+                directory: "/".into(),
+                stdin: false,
+            },
+        )
+        .unwrap();
+    let (_input, output, handle) = created.start().unwrap().into_parts().unwrap();
