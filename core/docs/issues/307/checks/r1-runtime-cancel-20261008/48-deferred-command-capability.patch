+    )
+    .unwrap_err();
+    assert_eq!(failure.phase, AdminPhase::Output);
+    let facts = failure.version_observation.unwrap();
+    assert!(!facts.complete);
+    assert_eq!(facts.client.as_deref(), Some("v2.2.4"));
+    assert_eq!(facts.server.as_deref(), Some("v2.2.4"));
+    peer.finish();
+    let mut responses = target_responses();
+    responses.extend(qualification());
+    responses.extend([
+        create(),
+        upgrade(&frame(1, info_fields("").as_bytes())),
+        inspection(0),
+        create(),
+        upgrade(&frame(2, b"original RPC acknowledgment unknown\n")),
+        inspection(78),
+    ]);
+    let (docker, peer) = Peer::new(responses, 8192);
+    let handle = target(&docker);
+    let mut admin = CtrAdmin::qualify(
+        docker,
+        cid(CLIENT),
+        "/run/containerd/containerd.sock".into(),
+    )
+    .unwrap();
+    let failure = handle
+        .cancel_with(&mut admin, Signal::Terminate)
+        .unwrap_err();
+    assert_eq!(failure.phase, AdminPhase::Result);
+    assert!(
+        failure.signal_start_attempted
+            && failure.metadata.is_some()
+            && failure.metadata_helper.is_some()
+    );
+    assert_eq!(failure.inspection.unwrap().known_root_exit(), Some(78));
+    assert!(failure.stderr.received > 0);
+    peer.finish();
+}
