+    format!("Client:\n  Version: v2.2.4\n  Revision: 193637f7ee8ae5f5aa5248f49e7baa3e6164966e\n  Go version: go1.25.10\n\nServer:\n  Version: {server}\n  Revision: 193637f7ee8ae5f5aa5248f49e7baa3e6164966e\n  UUID: dab2dd8c-483f-4fe2-a79b-eb12df4ca696\n").into_bytes()
+}
+fn artifact() -> Vec<u8> {
+    let path = std::env::var("LAYERFS_TEST_CTR_BINARY")
+        .expect("explicit unchanged published ctr fixture path");
+    let data = std::fs::read(path).unwrap();
+    assert_eq!(data.len(), 20_840_632);
+    let mut h = [0; 512];
+    h[..3].copy_from_slice(b"ctr");
+    for (range, value) in [
+        (100..108, 0o755u64),
+        (108..116, 0),
+        (116..124, 0),
+        (124..136, data.len() as u64),
+        (136..148, 0),
+    ] {
+        let text = format!("{:0width$o}\0", value, width = range.len() - 1);
+        h[range].copy_from_slice(text.as_bytes());
+    }
+    h[148..156].fill(b' ');
+    h[156] = b'0';
+    h[257..263].copy_from_slice(b"ustar\0");
+    h[263..265].copy_from_slice(b"00");
+    let sum: u32 = h.iter().map(|b| u32::from(*b)).sum();
+    h[148..156].copy_from_slice(format!("{sum:06o}\0 ").as_bytes());
