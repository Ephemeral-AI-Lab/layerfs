+const CLIENT: &str = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
+const TARGET: &str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+const EID: &str = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
+const HELPER: &str = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
+fn cid(value: &str) -> ContainerId {
+    ContainerId::parse(value).unwrap()
+}
+fn create() -> Vec<u8> {
+    fixed(201, format!("{{\"Id\":\"{HELPER}\"}}").as_bytes())
+}
+fn inspection(code: i32) -> Vec<u8> {
+    fixed(200,format!("{{\"ID\":\"{HELPER}\",\"ContainerID\":\"{CLIENT}\",\"Running\":false,\"ExitCode\":{code},\"Pid\":0}}").as_bytes())
+}
+fn profile(readonly: bool) -> Vec<u8> {
+    fixed(200,format!(r#"{{"Id":"{CLIENT}","Config":{{"User":"0:0","Tty":false,"Cmd":["sleep","infinity"],"Entrypoint":null}},"HostConfig":{{"Privileged":false,"ReadonlyRootfs":{readonly},"PidMode":"","SecurityOpt":["no-new-privileges=true"],"CapDrop":["ALL"],"CapAdd":null,"Devices":[]}},"Mounts":[{{"Type":"bind","Source":"/run/containerd/containerd.sock","Destination":"/run/containerd/containerd.sock","RW":true}}]}}"#).as_bytes())
+}
