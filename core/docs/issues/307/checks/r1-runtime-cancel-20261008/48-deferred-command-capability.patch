@@ -0,0 +1,167 @@
+//! Actual isolated client deployment facts checked before any privileged command.
+use super::super::{
+    json::{once, Json},
+    Docker,
+};
+use crate::{ContainerId, RuntimeError, WireFailure};
+use std::io::Read;
+pub(super) fn check(
+    docker: &Docker,
+    client: ContainerId,
+    address: &str,
+) -> Result<(), Box<WireFailure>> {
+    let mut response = docker.exchange(
+        "GET",
+        &format!("/v1.54/containers/{client}/json"),
+        false,
+        |_| Ok(()),
+    )?;
+    if response.status != 200 {
+        return Err(response.fail(RuntimeError::Http(response.status), None));
+    }
+    let mut observed = None;
+    let result = (|| {
+        let mut fields = 0;
+        let mut valid = true;
+        let mut json = Json::new(&mut response.body);
+        json.object(|j, key| {
+            if key.equals("Id") {
+                once(&mut fields, 1)?;
+                let id = j.string(true)?;
+                if id.overflow {
+                    return Err(RuntimeError::Protocol("admin CID width"));
+                }
+                observed = Some(ContainerId::parse(id.text())?);
+            } else if key.equals("Config") {
+                once(&mut fields, 2)?;
+                let mut bits = 0;
+                j.object(|j, key| {
+                    if key.equals("User") {
+                        once(&mut bits, 1)?;
+                        valid &= j.string_equals("0:0")?;
+                    } else if key.equals("Tty") {
+                        once(&mut bits, 2)?;
+                        valid &= !j.boolean()?;
+                    } else if key.equals("Cmd") {
+                        once(&mut bits, 4)?;
+                        valid &= strings(j, &["sleep", "infinity"])?;
+                    } else if key.equals("Entrypoint") {
+                        once(&mut bits, 8)?;
+                        if !j.null()? {
+                            valid &= strings(j, &[])?;
+                        }
+                    } else {
+                        j.skip(2)?;
+                    }
+                    Ok(())
+                })?;
+                valid &= bits == 15;
+            } else if key.equals("HostConfig") {
+                once(&mut fields, 4)?;
+                let mut bits = 0;
+                let mut tmpfs = 0;
+                j.object(|j, key| {
+                    if key.equals("Tmpfs") {
+                        once(&mut tmpfs, 1)?;
+                        if !j.null()? {
+                            j.object(|_, _| {
+                                Err(RuntimeError::Protocol("admin mutable tmpfs exposure"))
+                            })?;
+                        }
+                    } else if key.equals("Privileged") {
+                        once(&mut bits, 1)?;
+                        valid &= !j.boolean()?;
+                    } else if key.equals("ReadonlyRootfs") {
+                        once(&mut bits, 2)?;
+                        valid &= j.boolean()?;
+                    } else if key.equals("PidMode") {
+                        once(&mut bits, 4)?;
+                        valid &= j.string_equals("")?;
+                    } else if key.equals("SecurityOpt") {
+                        once(&mut bits, 8)?;
+                        valid &= strings(j, &["no-new-privileges=true"])?;
+                    } else if key.equals("CapDrop") {
+                        once(&mut bits, 16)?;
+                        valid &= strings(j, &["ALL"])?;
+                    } else if key.equals("CapAdd") {
+                        once(&mut bits, 32)?;
+                        if !j.null()? {
+                            valid &= strings(j, &[])?;
+                        }
+                    } else if key.equals("Devices") {
+                        once(&mut bits, 64)?;
+                        if !j.null()? {
+                            j.array(|_| Err(RuntimeError::Protocol("admin device exposure")))?;
+                        }
+                    } else {
+                        j.skip(2)?;
+                    }
+                    Ok(())
+                })?;
+                valid &= bits == 127;
+            } else if key.equals("Mounts") {
+                once(&mut fields, 8)?;
+                let mut count = 0;
+                j.array(|j| {
+                    if count != 0 {
+                        return Err(RuntimeError::Protocol("isolated admin single socket mount"));
+                    }
+                    count = 1;
+                    let mut bits = 0;
+                    j.object(|j, key| {
+                        if key.equals("Type") {
+                            once(&mut bits, 1)?;
+                            valid &= j.string_equals("bind")?;
+                        } else if key.equals("Source") {
+                            once(&mut bits, 2)?;
+                            valid &= j.string_equals(address)?;
+                        } else if key.equals("Destination") {
+                            once(&mut bits, 4)?;
+                            valid &= j.string_equals(address)?;
+                        } else if key.equals("RW") {
+                            once(&mut bits, 8)?;
+                            valid &= j.boolean()?;
+                        } else {
+                            j.skip(3)?;
+                        }
+                        Ok(())
+                    })?;
+                    valid &= bits == 15;
+                    Ok(())
+                })?;
+                valid &= count == 1;
+            } else {
+                j.skip(1)?;
+            }
+            Ok(())
+        })?;
+        json.finish()?;
+        if observed != Some(client) || fields != 15 || !valid {
+            return Err(RuntimeError::Protocol(
+                "exact isolated read-only admin deployment",
+            ));
+        }
+        Ok(())
+    })();
+    result.map_err(|cause| {
+        let mut failure = response.fail(cause, None);
+        failure.observed_container = observed;
+        failure.requested_container = Some(client);
+        failure
+    })
+}
+fn strings<R: Read>(j: &mut Json<R>, expected: &[&str]) -> Result<bool, RuntimeError> {
+    let mut index = 0;
+    let mut valid = true;
+    j.array(|j| {
+        if let Some(value) = expected.get(index) {
+            valid &= j.string_equals(value)?;
+        } else {
+            valid = false;
+            j.skip(3)?;
+        }
+        index = index.saturating_add(1);
+        Ok(())
+    })?;
+    Ok(valid && index == expected.len())
+}
