+//! Exact external runtime operation phases and original helper/target custody.
+use super::super::{
+    ExecCreateFailure, ExecHandle, OutputProgress, RuntimeOutput, SplitFailure, StartFailure,
+};
+use crate::{ContainerId, ExecId, ExecInspection, RuntimeError, WireFailure};
+use std::{fmt, io};
+/// Explicit one-process signal. No implicit escalation or descendant/all-task signal.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Signal {
+    Terminate,
+    Kill,
+}
+impl Signal {
+    pub(super) fn text(self) -> &'static str {
+        match self {
+            Self::Terminate => "TERM",
+            Self::Kill => "KILL",
+        }
+    }
+}
+/// Concrete original helper boundary; CLI acknowledgment is independent of target exit.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum AdminPhase {
+    Validate,
+    Create,
+    Start,
+    Split,
+    Output,
+    Inspect,
+    Result,
+}
+/// Bounded stderr diagnostics with total received bytes, never whole-output collection.
+#[derive(Default)]
+pub struct AdminStderr {
+    pub prefix: Vec<u8>,
+    pub received: u64,
+}
+impl fmt::Debug for AdminStderr {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("AdminStderr")
+            .field("prefix_bytes", &self.prefix.len())
+            .field("received", &self.received)
+            .finish()
+    }
+}
+impl io::Write for AdminStderr {
+    fn write(&mut self, input: &[u8]) -> io::Result<usize> {
+        let n = input.len().min(1024 - self.prefix.len());
+        self.prefix.extend_from_slice(&input[..n]);
+        self.received = self.received.saturating_add(input.len() as u64);
+        Ok(input.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+/// Read-only original binary transfer/hash facts, even after malformed/truncated archive.
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub struct ArtifactObservation {
+    pub declared_bytes: Option<u64>,
+    pub read_bytes: u64,
+    pub sha256: Option<String>,
+    pub complete: bool,
+}
+/// Deciding version facts retained independently of parser/helper completion.
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub struct VersionObservation {
+    pub client: Option<String>,
+    pub client_revision: Option<String>,
+    pub server: Option<String>,
+    pub server_revision: Option<String>,
+    pub server_uuid: Option<String>,
+    pub complete: bool,
+}
+/// Actual target facts, never relabeled requested selectors or qualified absence prematurely.
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub struct TargetObservation {
+    pub observed_container: Option<ContainerId>,
+    pub extensions_present: bool,
+    pub cni_present: bool,
+    pub runtime_name: Option<String>,
+    pub complete: bool,
+}
+/// Exact pinned version observations from complete output of a successful helper.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct RuntimeVersion {
+    pub client: String,
+    pub client_revision: String,
+    pub server: String,
+    pub server_revision: String,
+    pub server_uuid: String,
+}
+/// One completed administrative helper and its coherent original exit observation.
+#[derive(Debug)]
+pub struct AdminReceipt {
+    pub helper: ExecInspection,
+    pub output: OutputProgress,
+    pub stderr: AdminStderr,
+}
+/// Original qualified target metadata; absence is scoped to this read, not an atomic kill gate.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct TargetMetadata {
+    pub container: ContainerId,
+    pub cni_extension_absent: bool,
+    pub runtime_name: String,
+}
+/// One successfully completed fixed CLI signal. Target exit/streams/descendants remain independent.
+#[derive(Debug)]
+pub struct Cancellation {
+    pub container: ContainerId,
+    pub exec: ExecId,
+    pub signal: Signal,
+    pub metadata: TargetMetadata,
+    pub metadata_helper: AdminReceipt,
+    pub signal_helper: AdminReceipt,
+}
+/// Original helper failure; signal may have occurred despite nonzero/lost completion.
+#[derive(Debug)]
+pub enum AdminCause {
+    Runtime(RuntimeError),
+    Create(Box<ExecCreateFailure>),
+    Start(Box<StartFailure>),
+    Split(Box<SplitFailure>),
+    Inspect(Box<WireFailure>),
+}
+/// Original exact request selectors, reached phase and retained helper/output state.
+#[derive(Debug)]
+pub struct AdminFailure {
+    pub client: ContainerId,
+    pub target: Option<(ContainerId, ExecId)>,
+    pub phase: AdminPhase,
+    pub cause: AdminCause,
+    pub handle: Option<ExecHandle>,
+    pub output: Option<RuntimeOutput>,
+    pub stderr: AdminStderr,
+    pub inspection: Option<ExecInspection>,
+    pub fence_error: Option<io::Error>,
+    /// True when original signal helper Start entered; false is not an absence claim for other stages.
+    pub signal_start_attempted: bool,
+    pub metadata: Option<TargetMetadata>,
+    pub metadata_helper: Option<AdminReceipt>,
+    pub signal: Option<Signal>,
+    pub observed_version: Option<RuntimeVersion>,
+    pub version_helper: Option<AdminReceipt>,
+    pub artifact: Option<ArtifactObservation>,
+    pub version_observation: Option<VersionObservation>,
+    pub target_observation: Option<TargetObservation>,
+}
