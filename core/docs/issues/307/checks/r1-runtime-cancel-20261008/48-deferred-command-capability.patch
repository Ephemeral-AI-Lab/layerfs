@@ -0,0 +1,123 @@
+//! Positive-path exact external cancellation; explicit caller-owned Engine target/client.
+use layerfs_sandbox::{
+    backend::docker::{
+        admin::{CtrAdmin, Signal},
+        Docker, ExecRequest,
+    },
+    CommandIdentity, ContainerId,
+};
+use std::{io, time::Duration};
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<String> = std::env::args().collect();
+    assert_eq!(
+        args.len(),
+        4,
+        "Engine endpoint, owned read-only admin CID, owned ordinary target CID"
+    );
+    let docker = Docker::new(&args[1], Duration::from_secs(3))?;
+    let client = ContainerId::parse(&args[2])?;
+    let target = ContainerId::parse(&args[3])?;
+    let mut admin = CtrAdmin::qualify(
+        docker.clone(),
+        client,
+        "/run/containerd/containerd.sock".into(),
+    )
+    .map_err(|e| format!("qualify {e:?}"))?;
+    println!(
+        "QUALIFIED_EXTERNAL_CLIENT {:?} artifact={:?} helper={:?}",
+        admin.version(),
+        admin.artifact(),
+        admin.version_receipt()
+    );
+    let command = "sleep 86400 </dev/null >/dev/null 2>&1 & child=$!; trap 'printf \"ROOT_TERM\\n\"; exit 47' TERM; printf 'READY child=%s\\n' \"$child\"; wait \"$child\"";
+    let created = docker
+        .create_exec(
+            target,
+            ExecRequest {
+                identity: CommandIdentity { uid: 501, gid: 20 },
+                arguments: vec!["bash".into(), "-c".into(), command.into()],
+                environment: vec![],
+                directory: "/".into(),
+                stdin: false,
+            },
+        )
+        .map_err(|e| format!("target create {e:?}"))?;
+    let attached = created.start().map_err(|e| format!("target start {e:?}"))?;
+    let (_input, mut output, handle) = attached
+        .into_parts()
+        .map_err(|e| format!("target split {e:?}"))?;
+    let mut line = [0; 128];
+    let mut used = 0;
+    while used < line.len() {
+        let n = output
+            .read_stdout(&mut line[used..used + 1], &mut io::stderr())
+            .map_err(|e| format!("ready read {e:?}"))?;
+        if n == 0 {
+            return Err("target EOF before original READY".into());
+        }
+        used += n;
+        if line[used - 1] == b'\n' {
+            break;
+        }
+    }
+    let text = std::str::from_utf8(&line[..used])?;
+    let child = text
+        .strip_prefix("READY child=")
+        .ok_or("target READY syntax")?
+        .trim()
+        .parse::<u32>()?;
+    println!(
+        "TARGET_READY identity={:?} child_namespace_pid={child}",
+        handle.identity()
+    );
+    let active = handle
+        .inspect()
+        .map_err(|e| format!("running snapshot {e:?}"))?;
+    assert!(active.running && active.known_root_exit().is_none());
+    let receipt = handle
+        .cancel_with(&mut admin, Signal::Terminate)
+        .map_err(|e| format!("original signal {e:?}"))?;
+    println!("EXACT_SIGNAL {:?}", receipt);
+    let progress = output
+        .copy_to(&mut io::stdout(), &mut io::stderr())
+        .map_err(|e| format!("target output {e:?}"))?;
+    let ended = handle
+        .inspect()
+        .map_err(|e| format!("target exit snapshot {e:?}"))?;
+    assert_eq!(ended.known_root_exit(), Some(47));
+    println!("ROOT_EXIT {:?} {:?}", ended, progress);
+    // Namespace PID is used only to read proc metadata, never as a signal target.
+    let probe = "set -e; test -d \"/proc/$1\"; test \"$(cat /proc/$1/comm)\" = sleep; grep -q '^Uid:[[:space:]]*501[[:space:]]*501[[:space:]]*501[[:space:]]*501$' /proc/$1/status; test ! -e /run/containerd/containerd.sock; printf 'DESCENDANT_SURVIVES admin_socket_not_visible=true\\n'";
+    let created = docker
+        .create_exec(
+            target,
+            ExecRequest {
+                identity: CommandIdentity { uid: 501, gid: 20 },
+                arguments: vec![
+                    "bash".into(),
+                    "-c".into(),
+                    probe.into(),
+                    "--".into(),
+                    child.to_string(),
+                ],
+                environment: vec![],
+                directory: "/".into(),
+                stdin: false,
+            },
+        )
+        .map_err(|e| format!("survival create {e:?}"))?;
+    let (_input, output, probe) = created
+        .start()
+        .map_err(|e| format!("survival start {e:?}"))?
+        .into_parts()
+        .map_err(|e| format!("survival split {e:?}"))?;
+    output
+        .copy_to(&mut io::stdout(), &mut io::stderr())
+        .map_err(|e| format!("survival output {e:?}"))?;
+    let observed = probe
+        .inspect()
+        .map_err(|e| format!("survival exit {e:?}"))?;
+    assert_eq!(observed.known_root_exit(), Some(0));
+    println!("CANCEL_SCOPE root_only=true signal_not_exit=true descendant_or_fs_drain=NOT_CLAIMED");
+    Ok(())
+}
diff --git a/core/crates/layerfs-sandbox/src/backend/docker/admin/artifact.rs b/core/crates/layerfs-sandbox/src/backend/docker/admin/artifact.rs
new file mode 100644
index 000000000..55eaa966b
--- /dev/null
+++ b/core/crates/layerfs-sandbox/src/backend/docker/admin/artifact.rs
@@ -0,0 +1,196 @@
+//! Read-only verification of the fixed official binary before any privileged Exec.
+use super::super::{body::exact, Docker};
+use super::types::ArtifactObservation;
+use crate::{ContainerId, RuntimeError, WireFailure};
+use sha2::{Digest, Sha256};
+use std::io::Read;
+const BYTES: u64 = 20_840_632;
+const SHA: &str = "dba23ecfa03867ccd3a7ae442f5cef7f0d37564f8c96639500997b5bef5e03d8";
+pub(super) fn check(
+    docker: &Docker,
+    client: ContainerId,
+    observed: &mut ArtifactObservation,
+) -> Result<(), Box<WireFailure>> {
+    let mut r = docker.exchange(
+        "GET",
+        &format!("/v1.54/containers/{client}/archive?path=/usr/local/bin/ctr"),
+        false,
+        |_| Ok(()),
+    )?;
+    if r.status != 200 {
+        return Err(r.fail(RuntimeError::Http(r.status), None));
+    }
+    let parsed = (|| {
+        let mut hash = Sha256::new();
+        let mut header = [0; 512];
+        let mut seen = false;
+        let mut pax = false;
+        loop {
+            exact(&mut r.body, &mut header)?;
+            if header == [0; 512] {
+                if !seen {
+                    return Err(RuntimeError::Protocol(
+                        "missing fixed client archive member",
+                    ));
+                }
+                exact(&mut r.body, &mut header)?;
+                if header != [0; 512] {
+                    return Err(RuntimeError::Protocol("client archive end blocks"));
+                }
+                let mut bytes = [0; 8192];
+                loop {
+                    let n = r.body.read(&mut bytes)?;
+                    if n == 0 {
+                        break;
+                    }
+                    if bytes[..n].iter().any(|b| *b != 0) {
+                        return Err(RuntimeError::Protocol("client archive trailing member"));
+                    }
+                }
+                observed.complete = true;
+                break;
+            }
+            let declared = octal(&header[148..156])?;
+            let sum: u64 = header
+                .iter()
+                .enumerate()
+                .map(|(i, b)| {
+                    if (148..156).contains(&i) {
+                        32
+                    } else {
+                        u64::from(*b)
+                    }
+                })
+                .sum();
+            if sum != declared || header[257..263] != *b"ustar\0" {
+                return Err(RuntimeError::Protocol("fixed client ustar header/checksum"));
+            }
+            let size = octal(&header[124..136])?;
+            if header[156] == b'x' && !pax && !seen {
+                if size > 4096 {
+                    return Err(RuntimeError::Protocol("client PAX metadata window"));
+                }
+                let mut records = [0; 4096];
+                exact(&mut r.body, &mut records[..size as usize])?;
+                pax_records(&records[..size as usize])?;
+                padding(&mut r.body, size)?;
+                pax = true;
+                continue;
+            }
+            if seen
+                || !matches!(header[156], 0 | b'0')
+                || name(&header[..100]) != b"ctr"
+                || header[345..500].iter().any(|b| *b != 0)
+                || size != BYTES
+                || octal(&header[108..116])? != 0
+                || octal(&header[116..124])? != 0
+                || octal(&header[100..108])? & 0o022 != 0
+            {
+                return Err(RuntimeError::Protocol(
+                    "exact protected regular official client member",
+                ));
+            }
+            observed.declared_bytes = Some(size);
+            seen = true;
+            let mut remaining = size;
+            let mut bytes = [0; 8192];
+            while remaining != 0 {
+                let wanted = remaining.min(bytes.len() as u64) as usize;
+                let n = r.body.read(&mut bytes[..wanted])?;
+                if n == 0 {
+                    return Err(std::io::Error::from(std::io::ErrorKind::UnexpectedEof).into());
+                }
+                observed.read_bytes += n as u64;
+                hash.update(&bytes[..n]);
+                remaining -= n as u64;
+            }
+            observed.sha256 = Some(format!("{:x}", hash.clone().finalize()));
+            padding(&mut r.body, size)?;
+        }
+        if observed.sha256.as_deref() != Some(SHA) {
+            return Err(RuntimeError::Protocol(
+                "exact unchanged ctr2.2.4 arm64 binary from verified official archive",
+            ));
+        }
+        Ok(())
+    })();
+    parsed.map_err(|cause| {
+        let mut failure = r.fail(cause, None);
+        failure.requested_container = Some(client);
+        failure
+    })
+}
+fn name(bytes: &[u8]) -> &[u8] {
+    &bytes[..bytes.iter().position(|b| *b == 0).unwrap_or(bytes.len())]
+}
+fn octal(bytes: &[u8]) -> Result<u64, RuntimeError> {
+    let mut value = 0u64;
+    let mut digits = false;
+    let mut ended = false;
+    for &byte in bytes {
+        if byte == 0 || byte == b' ' {
+            if digits {
+                ended = true;
+            }
+            continue;
+        }
+        if ended || !(b'0'..=b'7').contains(&byte) {
+            return Err(RuntimeError::Protocol("client ustar numeric field"));
+        }
+        digits = true;
+        value = value
+            .checked_mul(8)
+            .and_then(|v| v.checked_add(u64::from(byte - b'0')))
+            .ok_or(RuntimeError::Protocol("client ustar numeric width"))?;
+    }
+    Ok(value)
+}
+fn padding(input: &mut impl Read, size: u64) -> Result<(), RuntimeError> {
+    let mut zeros = [0; 512];
+    let n = ((512 - size % 512) % 512) as usize;
+    exact(input, &mut zeros[..n])?;
+    if zeros[..n].iter().any(|b| *b != 0) {
+        return Err(RuntimeError::Protocol("client archive padding"));
+    }
+    Ok(())
+}
+fn pax_records(mut bytes: &[u8]) -> Result<(), RuntimeError> {
+    while !bytes.is_empty() {
+        let space = bytes
+            .iter()
+            .position(|b| *b == b' ')
+            .ok_or(RuntimeError::Protocol("client PAX record length"))?;
+        let length = std::str::from_utf8(&bytes[..space])
+            .ok()
+            .and_then(|s| s.parse::<usize>().ok())
+            .ok_or(RuntimeError::Protocol("client PAX numeric length"))?;
+        if length <= space + 2 || length > bytes.len() || bytes[length - 1] != b'\n' {
+            return Err(RuntimeError::Protocol("client PAX record framing"));
+        }
+        let record = &bytes[space + 1..length - 1];
+        let equal = record
+            .iter()
+            .position(|b| *b == b'=')
+            .ok_or(RuntimeError::Protocol("client PAX assignment"))?;
+        if ![b"mtime".as_slice(), b"atime", b"ctime"].contains(&&record[..equal]) {
+            return Err(RuntimeError::Protocol(
+                "client PAX path/identity/unsupported extension",
+            ));
+        }
+        let time = std::str::from_utf8(&record[equal + 1..])
+            .map_err(|_| RuntimeError::Protocol("client PAX timestamp UTF8"))?;
+        let (seconds, fraction) = match time.split_once('.') {
+            Some((s, f)) => (s, Some(f)),
+            None => (time, None),
+        };
+        if seconds.parse::<i64>().is_err()
+            || fraction.is_some_and(|f| f.is_empty() || !f.bytes().all(|b| b.is_ascii_digit()))
+        {
+            return Err(RuntimeError::Protocol(
+                "client PAX signed seconds/fraction syntax",
+            ));
+        }
+        bytes = &bytes[length..];
+    }
+    Ok(())
+}
diff --git a/core/crates/layerfs-sandbox/src/backend/docker/admin/client.rs b/core/crates/layerfs-sandbox/src/backend/docker/admin/client.rs
new file mode 100644
index 000000000..93a9662a4
--- /dev/null
+++ b/core/crates/layerfs-sandbox/src/backend/docker/admin/client.rs
@@ -0,0 +1,343 @@
+//! Fixed-command trusted client; endpoint/CNI metadata and signal completion stay distinct.
+use super::super::{Docker, ExecHandle};
+use super::{commands::Command, input::Input, metadata, types::*};
+use crate::{ContainerId, RuntimeError};
+/// Version-qualified isolated administrative client, borrowed from its acknowledged external owner.
+/// Caller excludes competing mutation of the selected target's containerd Extensions during cancel.
+#[derive(Debug)]
+pub struct CtrAdmin {
+    docker: Docker,
+    client: ContainerId,
+    address: String,
+    version: RuntimeVersion,
+    version_helper: AdminReceipt,
+    artifact: ArtifactObservation,
+}
+impl CtrAdmin {
+    /// Qualifies one actual fixed client/endpoint command. Client container ownership remains with caller.
+    /// Its isolated/read-only deployment is checked before root commands; no shared Store is accessed.
+    pub fn qualify(
+        docker: Docker,
+        client: ContainerId,
+        address: String,
+    ) -> Result<Self, Box<AdminFailure>> {
+        let invalid = |message| {
+            failure(
+                client,
+                None,
+                AdminPhase::Validate,
+                AdminCause::Runtime(RuntimeError::Protocol(message)),
+            )
+        };
+        if address != "/run/containerd/containerd.sock" {
+            return Err(invalid("explicit supported VM containerd endpoint"));
+        }
+        super::profile::check(&docker, client, &address).map_err(|cause| {
+            failure(
+                client,
+                None,
+                AdminPhase::Validate,
+                AdminCause::Inspect(cause),
+            )
+        })?;
+        let mut artifact = ArtifactObservation::default();
+        if let Err(cause) = super::artifact::check(&docker, client, &mut artifact) {
+            let mut original = failure(
+                client,
+                None,
+                AdminPhase::Validate,
+                AdminCause::Inspect(cause),
+            );
+            original.artifact = Some(artifact);
+            return Err(original);
+        }
+        let mut observed = VersionObservation::default();
+        let receipt = match run(&docker, client, &address, Command::Version, None, |input| {
+            metadata::version(input, &mut observed)
+        }) {
+            Ok(((), receipt)) => receipt,
+            Err(mut original) => {
+                original.version_observation = Some(observed);
+                original.artifact = Some(artifact);
+                return Err(original);
+            }
+        };
+        let version = RuntimeVersion {
+            client: observed.client.clone().expect("complete"),
+            client_revision: observed.client_revision.clone().expect("complete"),
+            server: observed.server.clone().expect("complete"),
+            server_revision: observed.server_revision.clone().expect("complete"),
+            server_uuid: observed.server_uuid.clone().expect("complete"),
+        };
+        if version.client != "v2.2.4"
+            || version.server != "v2.2.4"
+            || version.client_revision != metadata::REVISION
+            || version.server_revision != metadata::REVISION
+        {
+            let mut original = failure(
+                client,
+                None,
+                AdminPhase::Result,
+                AdminCause::Runtime(RuntimeError::Protocol(
+                    "exact pinned ctr and live server profile",
+                )),
+            );
+            original.observed_version = Some(version);
+            original.version_observation = Some(observed);
+            original.artifact = Some(artifact);
+            original.version_helper = Some(receipt);
+            return Err(original);
+        }
+        Ok(Self {
+            docker,
+            client,
+            address,
+            version,
+            version_helper: receipt,
+            artifact,
+        })
+    }
+    /// Exact completed client/server facts. UUID is an observation, not a new authority/incarnation guarantee.
+    pub fn version(&self) -> &RuntimeVersion {
+        &self.version
+    }
+    /// Exact initial helper's original output/status receipt.
+    pub fn version_receipt(&self) -> &AdminReceipt {
+        &self.version_helper
+    }
+    /// Installed official binary facts verified read-only before root command selection.
+    pub fn artifact(&self) -> &ArtifactObservation {
+        &self.artifact
+    }
+    /// Signals this acknowledged ordinary Exec once through the fixed external client.
+    /// CNI absence is observed immediately before signal under caller-owned administrative interval.
+    /// A later requested escalation is a separate operation; an unknown original signal is never replayed.
+    pub fn cancel(
+        &mut self,
+        target: &ExecHandle,
+        signal: Signal,
+    ) -> Result<Cancellation, Box<AdminFailure>> {
+        let (cid, eid) = target.identity();
+        let selected = Some((cid, eid));
+        if target.created.docker.socket != self.docker.socket
+            || cid == self.client
+            || target.created.request.identity.uid == 0
+            || target.created.request.identity.gid == 0
+        {
+            let mut original = failure(
+                self.client,
+                selected,
+                AdminPhase::Validate,
+                AdminCause::Runtime(RuntimeError::Protocol(
+                    "same Engine context/ordinary target/isolated admin identity",
+                )),
+            );
+            original.signal = Some(signal);
+            return Err(original);
+        }
+        let mut observed = TargetObservation::default();
+        let metadata_helper = match run(
+            &self.docker,
+            self.client,
+            &self.address,
+            Command::ContainerInfo(cid),
+            selected,
+            |input| metadata::info(input, &mut observed),
+        ) {
+            Ok(((), receipt)) => receipt,
+            Err(mut original) => {
+                original.target_observation = Some(observed);
+                original.signal = Some(signal);
+                return Err(original);
+            }
+        };
+        if observed.observed_container != Some(cid)
+            || !observed.extensions_present
+            || observed.cni_present
+            || observed.runtime_name.as_deref() != Some("io.containerd.runc.v2")
+            || !observed.complete
+        {
+            let mut original = failure(
+                self.client,
+                selected,
+                AdminPhase::Result,
+                AdminCause::Runtime(RuntimeError::Protocol(
+                    "exact runc target/CNI-free complete metadata",
+                )),
+            );
+            original.target_observation = Some(observed);
+            original.metadata_helper = Some(metadata_helper);
+            original.signal = Some(signal);
+            return Err(original);
+        }
+        let metadata = TargetMetadata {
+            container: cid,
+            cni_extension_absent: true,
+            runtime_name: observed.runtime_name.clone().expect("qualified"),
+        };
+        match run(
+            &self.docker,
+            self.client,
+            &self.address,
+            Command::Signal(cid, eid, signal),
+            selected,
+            |input| metadata::drain(input),
+        ) {
+            Ok(((), signal_helper)) => Ok(Cancellation {
+                container: cid,
+                exec: eid,
+                signal,
+                metadata,
+                metadata_helper,
+                signal_helper,
+            }),
+            Err(mut original) => {
+                original.metadata = Some(metadata);
+                original.target_observation = Some(observed);
+                original.metadata_helper = Some(metadata_helper);
+                Err(original)
+            }
+        }
+    }
+}
+fn failure(
+    client: ContainerId,
+    target: Option<(ContainerId, crate::ExecId)>,
+    phase: AdminPhase,
+    cause: AdminCause,
+) -> Box<AdminFailure> {
+    Box::new(AdminFailure {
+        client,
+        target,
+        phase,
+        cause,
+        handle: None,
+        output: None,
+        stderr: AdminStderr::default(),
+        inspection: None,
+        fence_error: None,
+        signal_start_attempted: false,
+        metadata: None,
+        metadata_helper: None,
+        signal: None,
+        observed_version: None,
+        version_helper: None,
+        artifact: None,
+        version_observation: None,
+        target_observation: None,
+    })
+}
+fn run<T>(
+    docker: &Docker,
+    client: ContainerId,
+    address: &str,
+    command: Command,
+    target: Option<(ContainerId, crate::ExecId)>,
+    parse: impl FnOnce(&mut Input<'_>) -> Result<T, RuntimeError>,
+) -> Result<(T, AdminReceipt), Box<AdminFailure>> {
+    let explicit_signal = match command {
+        Command::Signal(_, _, signal) => Some(signal),
+        _ => None,
+    };
+    let created = docker
+        .create_selected_exec(client, command.request(address))
+        .map_err(|cause| {
+            let mut original = failure(
+                client,
+                target,
+                AdminPhase::Create,
+                AdminCause::Create(cause),
+            );
+            original.signal = explicit_signal;
+            original
+        })?;
+    let signal = explicit_signal.is_some();
+    let attached = created.start().map_err(|cause| {
+        let mut original = failure(client, target, AdminPhase::Start, AdminCause::Start(cause));
+        original.signal_start_attempted = signal;
+        original.signal = explicit_signal;
+        original
+    })?;
+    let (_input, mut output, handle) = attached.into_parts().map_err(|cause| {
+        let mut original = failure(client, target, AdminPhase::Split, AdminCause::Split(cause));
+        original.signal_start_attempted = signal;
+        original.signal = explicit_signal;
+        original
+    })?;
+    let mut stderr = AdminStderr::default();
+    let (parsed, read_fence_error) = {
+        let mut reader = Input {
+            output: &mut output,
+            stderr: &mut stderr,
+            original: None,
+            fence_error: None,
+        };
+        let result = parse(&mut reader);
+        let parsed = match reader.original {
+            Some(error) => Err(error),
+            None => result,
+        };
+        (parsed, reader.fence_error)
+    };
+    let value = match parsed {
+        Ok(value) => value,
+        Err(error) => {
+            let fence_error = read_fence_error.or_else(|| output.fence());
+            let mut original = failure(
+                client,
+                target,
+                AdminPhase::Output,
+                AdminCause::Runtime(error),
+            );
+            original.handle = Some(handle);
+            original.output = Some(output);
+            original.stderr = stderr;
+            original.fence_error = fence_error;
+            original.signal_start_attempted = signal;
+            original.signal = explicit_signal;
+            return Err(original);
+        }
+    };
+    let inspection = match handle.inspect() {
+        Ok(value) => value,
+        Err(cause) => {
+            let mut original = failure(
+                client,
+                target,
+                AdminPhase::Inspect,
+                AdminCause::Inspect(cause),
+            );
+            original.handle = Some(handle);
+            original.output = Some(output);
+            original.stderr = stderr;
+            original.signal_start_attempted = signal;
+            original.signal = explicit_signal;
+            return Err(original);
+        }
+    };
+    if inspection.known_root_exit() != Some(0) {
+        let mut original = failure(
+            client,
+            target,
+            AdminPhase::Result,
+            AdminCause::Runtime(RuntimeError::Protocol(
+                "helper root exit not known zero; no CLI/RPC success credited",
+            )),
+        );
+        original.inspection = Some(inspection);
+        original.handle = Some(handle);
+        original.output = Some(output);
+        original.stderr = stderr;
+        original.signal_start_attempted = signal;
+        original.signal = explicit_signal;
+        return Err(original);
+    }
+    Ok((
+        value,
+        AdminReceipt {
+            helper: inspection,
+            output: output.progress(),
+            stderr,
+        },
+    ))
+}
