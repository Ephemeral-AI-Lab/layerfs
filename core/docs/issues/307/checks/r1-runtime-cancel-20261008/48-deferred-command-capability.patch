+//! The only root command vocabulary; no arbitrary privileged argv/env/cwd surface.
+use super::super::ExecRequest;
+use super::types::Signal;
+use crate::{CommandIdentity, ContainerId, ExecId};
+#[derive(Clone, Copy, Debug)]
+pub(super) enum Command {
+    Version,
+    ContainerInfo(ContainerId),
+    Signal(ContainerId, ExecId, Signal),
+}
+impl Command {
+    pub fn request(self, address: &str) -> ExecRequest {
+        let mut arguments = vec![
+            "/usr/local/bin/ctr".into(),
+            "--address".into(),
+            address.into(),
+            "--namespace".into(),
+            "moby".into(),
+            "--timeout".into(),
+            "5s".into(),
+            "--connect-timeout".into(),
+            "2s".into(),
+        ];
+        match self {
+            Self::Version => arguments.push("version".into()),
+            Self::ContainerInfo(cid) => {
+                arguments.extend(["containers".into(), "info".into(), cid.to_string()])
+            }
+            Self::Signal(cid, eid, signal) => arguments.extend([
+                "tasks".into(),
+                "kill".into(),
+                "--exec-id".into(),
+                eid.to_string(),
+                "--signal".into(),
+                signal.text().into(),
+                cid.to_string(),
+            ]),
+        }
+        ExecRequest {
+            identity: CommandIdentity { uid: 0, gid: 0 },
+            arguments,
+            environment: vec!["CONTAINERD_SUPPRESS_DEPRECATION_WARNINGS=true".into()],
+            directory: "/".into(),
+            stdin: false,
+        }
+    }
+}
