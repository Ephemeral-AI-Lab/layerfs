      "index": "aL",
      "roundness": null,
      "seed": 35802556,
      "version": 3,
      "versionNonce": 1473564397,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793813080131,
      "created": 1793813080128,
      "link": null,
      "locked": false,
      "text": "A sqlite Store's file must live on the\nmachine it is placed on. PostgreSQL is on\nno machine (G3): it is never refused.",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A sqlite Store's file must live on the\nmachine it is placed on. PostgreSQL is on\nno machine (G3): it is never refused.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Xykk2ylgZEhzsmze7Sdi6",
