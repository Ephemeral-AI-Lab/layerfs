      "link": null,
      "locked": false,
      "text": "refusal:  StoragePlacement { store, machine, backend, reason }",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "refusal:  StoragePlacement { store, machine, backend, reason }",
