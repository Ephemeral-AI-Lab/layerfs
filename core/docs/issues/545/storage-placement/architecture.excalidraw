    },
    {
      "id": "2U5bbUWUkiKnyMQK-MfAr",
      "type": "text",
      "x": 658,
      "y": 798,
      "width": 543.4000000000002,
      "height": 97.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 87247492,
      "version": 2,
      "versionNonce": 1245200444,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793813080131,
      "created": 1793813080130,
      "link": null,
      "locked": false,
      "text": "asks it in the check phase, before\neither machine is reached: no send, no\ninstall \u2014 nothing lands on that disk",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "asks it in the check phase, before\neither machine is reached: no send, no\ninstall \u2014 nothing lands on that disk",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "P9X5VS9Kob_oGs1mDdtEi",
      "type": "text",
