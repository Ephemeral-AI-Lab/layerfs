      "updated": 1793813080131,
      "created": 1793813080109,
      "link": null,
      "locked": false,
      "text": "A local sqlite Store lives only where its file lives: the machine that\nruns its calls. One guard in the placement layer; no dial, start or write.",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A local sqlite Store lives only where its file lives: the machine that\nruns its calls. One guard in the placement layer; no dial, start or write.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
