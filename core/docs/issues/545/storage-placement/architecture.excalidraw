    {
      "id": "b5hBRQrOE75VnFJ-2sDUK",
      "type": "text",
      "x": 44,
      "y": 798,
      "width": 543.4000000000002,
      "height": 97.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
