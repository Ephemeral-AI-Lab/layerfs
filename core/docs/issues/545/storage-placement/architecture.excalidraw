      "labelPosition": null
    },
    {
      "id": "RM6wAnI-o7SJ3kZx4GzPG",
      "type": "text",
      "x": 44,
      "y": 996,
      "width": 1158.2999999999984,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
