      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 726354692,
      "version": 2,
      "versionNonce": 1198167996,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793813080131,
      "created": 1793813080129,
      "link": null,
      "locked": false,
      "text": "asks it when the machine is resolved \u2014\nbefore the name is claimed, before any\nlaunch: never routed to that machine",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "asks it when the machine is resolved \u2014\nbefore the name is claimed, before any\nlaunch: never routed to that machine",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
