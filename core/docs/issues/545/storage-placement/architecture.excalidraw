    {
      "id": "duSugjD_6WgNmwqfxwuUR",
      "type": "text",
      "x": 356,
      "y": 532,
      "width": 586.3000000000001,
      "height": 97.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
