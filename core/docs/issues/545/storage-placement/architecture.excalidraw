      "boundElements": null,
      "updated": 1793813080131,
      "created": 1793813080131,
      "link": null,
      "locked": false,
      "text": "store.pull is never refused: pulling a Store off such a machine is the way off it",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "store.pull is never refused: pulling a Store off such a machine is the way off it",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
