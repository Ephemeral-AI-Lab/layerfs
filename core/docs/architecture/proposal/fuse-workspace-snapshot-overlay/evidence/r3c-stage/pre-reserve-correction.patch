+            .checked_add(bytes)
+            .ok_or(WorkspaceError::Io)?;
+        state.metadata_reserved = state
+            .metadata_reserved
+            .checked_add(bytes)
+            .ok_or(WorkspaceError::Io)?;
+        *available = available.checked_add(bytes).ok_or(WorkspaceError::Io)?;
+        Ok(())
