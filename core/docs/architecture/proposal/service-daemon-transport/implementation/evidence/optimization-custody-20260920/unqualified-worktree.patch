@@ -0,0 +1,71 @@
+//! Configure native buffer bounds before a connection can advertise its window.
+use crate::contract::{Code, Failure, MAX_SESSIONS};
+use nix::{
+    errno::Errno,
+    poll::{poll, PollFd, PollFlags},
+    sys::socket::{
+        self, getsockopt, setsockopt, sockopt, AddressFamily, Backlog, SockFlag, SockType,
+        SockaddrStorage,
+    },
+};
+use std::{
+    net::{SocketAddr, TcpListener, TcpStream},
+    os::fd::{AsFd, AsRawFd, OwnedFd},
+};
+fn prepared(address: SocketAddr) -> Result<OwnedFd, Failure> {
+    let family = if address.is_ipv4() {
+        AddressFamily::Inet
+    } else {
+        AddressFamily::Inet6
+    };
+    let fd = socket::socket(family, SockType::Stream, SockFlag::empty(), None)
+        .map_err(|_| Code::Unsupported)?;
+    configure(&fd)?;
+    Ok(fd)
+}
+/// A bounded native listener. Accepted connections inherit the buffer selection.
+pub fn listen(address: SocketAddr) -> Result<TcpListener, Failure> {
+    let fd = prepared(address)?;
+    setsockopt(&fd, sockopt::ReuseAddr, &true).map_err(|_| Code::Unsupported)?;
+    socket::bind(fd.as_raw_fd(), &SockaddrStorage::from(address)).map_err(|_| Code::Io)?;
+    socket::listen(
+        &fd,
+        Backlog::new(MAX_SESSIONS as i32).map_err(|_| Code::Unsupported)?,
+    )
+    .map_err(|_| Code::Io)?;
+    Ok(TcpListener::from(fd))
+}
+pub(super) fn connect(address: SocketAddr) -> Result<TcpStream, Failure> {
+    let stream = TcpStream::from(prepared(address)?);
+    stream.set_nonblocking(true)?;
+    match socket::connect(stream.as_raw_fd(), &SockaddrStorage::from(address)) {
+        Ok(()) => {}
+        Err(Errno::EINPROGRESS) => {
+            let mut fds = [PollFd::new(stream.as_fd(), PollFlags::POLLOUT)];
+            if poll(&mut fds, 5000u16).map_err(|_| Code::Io)? == 0
+                || getsockopt(&stream, sockopt::SocketError).map_err(|_| Code::Io)? != 0
+            {
+                return Err(Code::Io.into());
+            }
+        }
+        Err(_) => return Err(Code::Io.into()),
+    }
+    stream.set_nonblocking(false)?;
+    validate(&stream)?;
+    stream.set_nodelay(true)?;
+    Ok(stream)
+}
+pub(super) fn configure(fd: &impl AsFd) -> Result<(), Failure> {
+    let size = 128usize * 1024;
+    setsockopt(fd, sockopt::SndBuf, &size).map_err(|_| Code::Unsupported)?;
+    setsockopt(fd, sockopt::RcvBuf, &size).map_err(|_| Code::Unsupported)?;
+    validate(fd)
+}
+fn validate(fd: &impl AsFd) -> Result<(), Failure> {
+    if getsockopt(fd, sockopt::SndBuf).map_err(|_| Code::Unsupported)? > 256 * 1024
+        || getsockopt(fd, sockopt::RcvBuf).map_err(|_| Code::Unsupported)? > 256 * 1024
+    {
+        return Err(Code::Capacity.into());
+    }
+    Ok(())
+}
